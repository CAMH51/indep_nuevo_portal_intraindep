<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doble factor de autenticación</title>

        <link rel="stylesheet" href="./styles/styles.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" integrity="sha256-pdY4ejLKO67E0CM2tbPtq1DJ3VGDVVdqAR6j3ZwdiE4=" crossorigin="anonymous">
</head>
<body class="bg-white min-h-screen flex items-center justify-center p-6">

    <%- include('./admin/partials/navbargobmx.ejs') %>


    <div class="w-full max-w-md">
    <div class="bg-white backdrop-blur-xl border border-2 border-[#9b2247] rounded-2xl shadow-2xl shadow-black/40 p-8">
        <form method="POST" action="/auth/logout" class="m-0">
        Regresar a iniciar sesión <button type="submit" class=" font-semibold text-md hover:underline"> Cerrar Sesión</button>
        </form>
      <!-- Icono -->
      <div class="flex justify-center mb-6">
        <div class="w-16 h-16 rounded-full bg-[#611323] border border-indigo-500/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 10-8 0v2" />
          </svg>
        </div>
      </div>
 
      <!-- Título -->
      <h1 class="text-black text-2xl font-semibold text-center">Verificación en dos pasos</h1>
      <p class="text-[#611323] text-sm text-center mt-2 leading-relaxed">
        Ingresa el código de 6 dígitos que enviamos a
        <span class="text-black font-medium">tu correo electrónico</span>
      </p>

<!--       <div class="flex justify-center items-center gap-2 mt-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
        </svg>
        <p class="text-black text-sm">
          El código expira en <span id="expire-count" class="text-[#9b2247] font-medium">03:00</span>
        </p>
      </div> -->
 
      <!-- Inputs del código -->
      <div class="flex justify-center gap-2 sm:gap-3 mt-8" id="code-inputs">
        <input type="text" inputmode="numeric" maxlength="1" class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-2xl font-semibold text-white bg-slate-800/60 border border-slate-700 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40 transition-all" />
        <input type="text" inputmode="numeric" maxlength="1" class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-2xl font-semibold text-white bg-slate-800/60 border border-slate-700 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40 transition-all" />
        <input type="text" inputmode="numeric" maxlength="1" class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-2xl font-semibold text-white bg-slate-800/60 border border-slate-700 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40 transition-all" />
        <input type="text" inputmode="numeric" maxlength="1" class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-2xl font-semibold text-white bg-slate-800/60 border border-slate-700 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40 transition-all" />
        <input type="text" inputmode="numeric" maxlength="1" class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-2xl font-semibold text-white bg-slate-800/60 border border-slate-700 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40 transition-all" />
        <input type="text" inputmode="numeric" maxlength="1" class="otp-input w-12 h-14 sm:w-14 sm:h-16 text-center text-2xl font-semibold text-white bg-slate-800/60 border border-slate-700 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40 transition-all" />
      </div>
 
      <!-- Mensaje de error (oculto por defecto) -->
      <p id="error-msg" class="hidden text-[#611323] text-sm text-center font-semibold mt-4 bg-[#e6d194] rounded-xl p-2">Código incorrecto. Inténtalo nuevamente.</p>
      
 
      <!-- Botón verificar -->
      <button id="verify-btn" class="w-full mt-8 bg-[#611323] hover:bg-[#9b2247] active:scale-[0.98] text-white font-medium py-3.5 rounded-xl transition-all duration-150 shadow-lg shadow-indigo-600/20 flex items-center justify-center gap-2">
        <span>Verificar código</span>
      </button>
 
      <!-- Reenviar código -->
<!--       <div class="text-center mt-6">
        <p class="text-slate-500 text-sm">
          ¿No recibiste el código?
          <button id="resend-btn" class="text-[#611323] font-medium hover:text-[#9b2247] transition-colors ml-1">
            Reenviar código
          </button>
        </p>
        <p id="timer-text" class="hidden text-[#e6d194] text-sm mt-1">
          Podrás reenviarlo en <span id="timer-count" class="text-slate-300 font-medium">30</span>s
        </p>
      </div> -->
 
    </div>
 
    <p class="text-slate-600 text-xs text-center mt-6">
      Protegemos tu cuenta con autenticación de doble factor
    </p>
  </div>
    

<script >
  const inputs = document.querySelectorAll('.otp-input');
  const verifyBtn = document.getElementById('verify-btn');
  const resendBtn = document.getElementById('resend-btn');
  const timerText = document.getElementById('timer-text');
  const timerCount = document.getElementById('timer-count');
  const errorMsg = document.getElementById('error-msg');
 
  inputs.forEach((input, index) => {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/[^0-9]/g, '');
      if (input.value && index < inputs.length - 1) {
        inputs[index + 1].focus();
      }
      errorMsg.classList.add('hidden');
    });
 
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && index > 0) {
        inputs[index - 1].focus();
      }
    });
 
    input.addEventListener('paste', (e) => {
      e.preventDefault();
      const paste = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, inputs.length);
      paste.split('').forEach((char, i) => {
        if (inputs[i]) inputs[i].value = char;
      });
      const next = inputs[Math.min(paste.length, inputs.length - 1)];
      next.focus();
    });
  });
 
  verifyBtn.addEventListener('click', async () => {
    const formData = new FormData();
    const code = Array.from(inputs).map(i => i.value).join('');
    formData.append('code',code);
    const params = new URLSearchParams(window.location.search);
    const id = params.get("id");
    formData.append('id_user',id);
    if (code.length < 6) {
      errorMsg.textContent = 'Completa los 6 dígitos del código.';
      errorMsg.classList.remove('hidden');
      return;
    }
    try {
        verifyBtn.disabled = true;
        verifyBtn.innerHTML = '<span>Verificando...</span>';
        const response = await fetch('https://qa-api-multifactor.indep.gob.mx/api/v1/mfa/verify',{
        method:'POST',
        body:formData
    });
    const data = await response.json();

    if(data.success){
        //console.log(data.msg)
        window.location.href = '/dashboard';
    }else{
        //console.log(data.msg)
        errorMsg.textContent = data.msg;
        errorMsg.classList.remove('hidden');
    }
    } catch (error) {
        
    }finally{
        verifyBtn.disabled = false;
        verifyBtn.innerHTML = '<span>Verificar código</span>';
    }
    
  });


 
  const expireCount = document.getElementById('expire-count');
  let expireSeconds = 180;
 
  const expireIntervalId = setInterval(() => {
    expireSeconds--;
    const minutes = Math.floor(expireSeconds / 60);
    const seconds = expireSeconds % 60;
    expireCount.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
 
    if (expireSeconds <= 0) {
      clearInterval(expireIntervalId);
      expireCount.textContent = '00:00';
      inputs.forEach(i => { i.value = ''; i.disabled = true; });
      verifyBtn.disabled = true;
      verifyBtn.classList.add('opacity-50', 'cursor-not-allowed');
      errorMsg.textContent = 'El código expiró. Solicita uno nuevo.';
      errorMsg.classList.remove('hidden');
    }
  }, 1000);
 
  function resetExpireTimer() {
    expireSeconds = 180;
    expireCount.textContent = '03:00';
    inputs.forEach(i => i.disabled = false);
    verifyBtn.disabled = false;
    verifyBtn.classList.remove('opacity-50', 'cursor-not-allowed');
  }
 
  let cooldown = 0;
  let intervalId = null;
 
  function startCooldown() {
    cooldown = 30;
    resendBtn.classList.add('hidden');
    timerText.classList.remove('hidden');
    timerCount.textContent = cooldown;
 
    intervalId = setInterval(() => {
      cooldown--;
      timerCount.textContent = cooldown;
      if (cooldown <= 0) {
        clearInterval(intervalId);
        resendBtn.classList.remove('hidden');
        timerText.classList.add('hidden');
      }
    }, 1000);
  }
 
  resendBtn.addEventListener('click', () => {
    inputs.forEach(i => i.value = '');
    inputs[0].focus();
    errorMsg.classList.add('hidden');
    resetExpireTimer();
    // Aquí iría la lógica real para reenviar el código
    startCooldown();
  });
</script>
</body>
</html>

