<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
    <!-- Enlace al archivo CSS de salida -->
    <link rel="stylesheet" href="./styles/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" integrity="sha256-pdY4ejLKO67E0CM2tbPtq1DJ3VGDVVdqAR6j3ZwdiE4=" crossorigin="anonymous">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js" integrity="sha256-Tobw4i5HcbW4qsJMYTxmGAameLGvooTQPPatA9PiGgo=" crossorigin="anonymous"></script>
</head>
<body class="flex items-center justify-center min-h-screen p-5">
  <%- include('./admin/partials/navbargobmx.ejs') %>
    <!-- Contenedor principal: similar a la imagen pero con un diseño moderno, responsivo y fiel a la estructura -->
    <div class="w-full max-w-md">
        <!-- Tarjeta de inicio de sesión, fondo blanco con sombra elegante y bordes suaves -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden card-hover">
            <!-- Cabecera decorativa con línea de color institucional (azul que recuerda a gobierno/gris profesional) -->
            <div class="h-2 bg-rojo-claro to-indigo-600"></div>
            
            <div class="p-7 sm:p-8">
                <!-- Logo / ícono de acceso + título principal -->
                <div class="flex flex-col items-center text-center mb-6">
                    <div class="h-14 w-14 bg-blue-50 rounded-full flex items-center justify-center mb-3 shadow-sm">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-800 tracking-tight">Iniciar Sesión</h1>
                    <p class="text-sm text-gray-500 mt-1.5">Ingresa tus credenciales para acceder</p>
                </div>
                
                <!-- Formulario de acceso -->
                <form class="space-y-5" id="formLogin" method="post" action="/login">
                    
                    <!-- Campo Correo electrónico -->
                    <div class="space-y-1.5">
                        <label for="email" class="block text-sm font-semibold text-gray-700">
                            <i class="bi bi-envelope"></i> Correo electrónico
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="bi bi-at"></i>
                            </div>
                            <input type="email" id="user" name="user" value="" 
                                   class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl bg-gray-50 focus:bg-white  focus:transition-all duration-200 text-gray-800 text-sm"
                                   placeholder="tucorreo@ejemplo.com" autocomplete="email" onchange="inputEmail(this.value)">
                        </div>
                        <div id="errorEmail">

                        </div>
                    </div>
                    
                    <!-- Campo Contraseña -->
                    <div class="space-y-1.5">
                        <label for="password" class="block text-sm font-semibold text-gray-700">
                            <i class="bi bi-key-fill"></i> Contraseña
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="bi bi-lock-fill"></i>
                            </div>
                            <input type="password" id="pass" name="pass" value="" 
                                   class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-xl bg-gray-50 focus:bg-white focus: transition-all duration-200 text-gray-800 text-sm"
                                   placeholder="••••••••" onchange="inputPassword(this.value)">
                            
                            <!-- Botón toggle para mostrar/ocultar contraseña (extra pero útil) -->
                            <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 focus:outline-none" >
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div id="errorPass">

                            </div>
                    <!-- Botón de inicio de sesión moderno y responsivo -->
                    <button type="submit" id="loginBtn"
                            class="w-full mt-2 bg-rojo-oscuro hover:bg-rojo-claro active:bg-rojo-claro text-white font-semibold py-2.5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 btn-transition">
                        <i class="fas fa-sign-in-alt text-sm"></i> Iniciar Sesión
                    </button>
                    
                    <!-- Mensaje de demo o retroalimentación (similar a notificación sutil) -->
                    <div id="messageArea" class="mt-3 text-center text-sm min-h-[40px]"></div>
                </form>
                
            </div>
        </div>
    </div>
 <%- include('./admin/components/scriptValidador.ejs') %>

    <script>
        const formLogin = document.getElementById('formLogin');
        const emailInput = document.getElementById('user');
        const passwordInput = document.getElementById('pass');

        formLogin.addEventListener('submit', async(e) => {
            e.preventDefault();
            const email = emailInput.value;
            const password = passwordInput.value;

            const formData = new FormData(formLogin)

            if(validarEmail(email).valido && validarPassword(password).valido){
                const response = await fetch('/auth/login',{
                    method:'POST',
                    headers: { 'x-csrf-token': '<%= csrfToken %>' },
                    body:formData
                });
                const data = await response.json();
                console.log('data');
                if(data.success){
                    Swal.fire({
                        title: data.msg,
                        icon: "success",
                        confirmButtonText: "OK",
                        }).then(async (result) => {
                        /* Read more about isConfirmed, isDenied below */
                        if (result.isConfirmed){
                            const formData = new FormData();
                            formData.append('email',email)
                            const response = await fetch('https://qa-api-multifactor.indep.gob.mx/api/v1/token',{
                                method:'POST',
                                body:formData
                            })

                            const data = await response.json();

                           if(data.success){
                            const formData2 = new FormData();
                            formData2.append('isActiveDirectory',false);
                            const otg = await fetch('https://qa-api-multifactor.indep.gob.mx/api/v1/mfa/login',{
                                method:'POST',
                                headers: {
                                    'Authorization': `Bearer ${data.token}`
                                },
                                body:formData2
                            });

                            const dataOtg = await otg.json();

                            console.log('otg',dataOtg)
                             if(dataOtg.success){
                                window.location.href = '/mfa?id='+dataOtg.data.id;
                            } 
                           }
                        }
                    });
                }else{
                    Swal.fire({
                        title: data.msg,
                        icon: "warning",
                        draggable: true
                    });
                }
                console.log(data);

            }

        });

        function inputEmail(value){
            const error = document.getElementById('errorEmail');
            const resultado = validarEmail(value);
            if(!resultado.valido){
                error.classList.remove('hidden');
                error.classList.add('text-lg','text-rojo-oscuro','font-bold','pl-3');
                error.innerHTML = resultado.msg;
            }else{
                error.classList.add('hidden');
                error.innerHTML = "";
            }
            console.log(resultado);


        }

        function inputPassword(value){
            const error = document.getElementById('errorPass');
            const resultado = validarPassword(value);
             if(!resultado.valido){
                error.classList.remove('hidden');
                error.classList.add('text-lg','text-rojo-oscuro','font-bold','pl-3');
                error.innerHTML = resultado.msg;
            }else{
                error.classList.add('hidden');
                error.innerHTML = "";
            }
            console.log(resultado);
        }


        function validarEmail(email){
            const regexEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if(email.length === 0){
                return {
                    valido:false,
                    msg:"<i class='bi bi-exclamation-circle'></i> correo electrónico requerido"
                };
            }

            if(!regexEmail.test(email)){
                return {
                    valido:false,
                    msg:"<i class='bi bi-exclamation-circle'></i>  El correo electrónico no tiene un formato válido"
                };
            }

            if(email.includes(" ")){
                return {
                    valido:false,
                    msg:"<i class='bi bi-exclamation-circle'></i>  El correo electrónico no debe contener espacios"
                };
            }

            if(email.length > 254){
                return {
                    valido:false,   
                    msg:"<i class='bi bi-exclamation-circle'></i>  El correo electrónico es demasiado largo"
                };
            }

            return {
                valido:true,
                msg:"Correo Electrónico válido"
            };
        }

        function validarPassword(password){
            if(password.length === 0){
                return {
                    valido:false,
                    msg:"<i class='bi bi-exclamation-circle'></i>  La contraseña es requerida"
                };
            }

            if(password.length < 6){
                return {
                    valido:false,
                    msg:"<i class='bi bi-exclamation-circle'></i>  La contraseña debe tener al menos 6 caracteres"
                };
            }

            if(password.length == 0 ){
                return {
                    valido:false,
                    msg:"<i class='bi bi-exclamation-circle'></i>  La contraseña no puede estar vacía"
                };
            }

            return {
                valido:true,
                msg:"Contraseña válida"
            };
        

        }

        document.getElementById('togglePassword').addEventListener("click",()=>{
            const input = document.getElementById('pass');
            if(input.type === "password"){
                input.type = "text";
            }else{
                input.type = "password";
            }
        })

    </script>
</body>
</html>