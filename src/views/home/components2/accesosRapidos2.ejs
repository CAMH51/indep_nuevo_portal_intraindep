    <%- include('../components2/titulo.ejs',{titulo:"Accesos Rápidos"}) %>
    <div class="col-lg-12" >
      <div class="row g-2">
        <%if(ligas.length === 0){%>
          <div class="bg-white-card text-center text-muted py-4 mb-4" style="font-size:.87rem;">
            <i class="bi bi-emoji-smile" style="font-size:2.5rem;color:#ccc;"></i>
            <p class="mt-2 mb-0">No hay Ligas que mostrar.</p>
          </div>
        <%}else{%>
          <% ligas.forEach(item =>{ %>
            <div class="col-6 col-lg-12">
              <a 
              href="<%= item.url_liga !== null ? item.url_liga : item.fk_id_pagina !== null ? '/'+ item.pagina.ruta_pag + '/' + item.pagina.nombre_pag : '#'  %>"  
              class="underline"
              target="_blank"
              >
              <i class="bi bi-link"></i>
              <%= item.nombre_liga %>
              </a>
            </div>
          <%});%>
        <%}%>    
      </div>
    </div>