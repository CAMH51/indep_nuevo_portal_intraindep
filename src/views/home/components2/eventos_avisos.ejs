      <style>
  .table {
  width: 100% !important;
  border: 2px solid #9b2247!important;
  border-radius: 15px;
  overflow: hidden;
}

.table thead tr th {
  text-align: center;
  background: #611232 !important;
  color: #e6d194 !important;
  margin: 5px;
}

.table thead th {
  width: 300px;
  text-align: center;
  border: 1px solid #98989a;
}

.table tbody {
  border-radius: 15px;}
.table tbody tr {
  border-radius: 15px !important;
}
.table tbody td {
  text-align: center;
  border: 1px solid #98989a;
}


.table .dataTables_length {
  margin-bottom: 10px;
}

.table .dataTables_filter {
  margin-bottom: 10px;
}

      </style>
      <section class="w-full p-2">
        <%- include('../components2/titulo.ejs',{titulo:"Eventos y Avisos"}) %>
        <div class="bg-white-card p-0 overflow-hidden mt-3 mb-4" id="eventosAvisos">
          <div class="table-responsive">
            <table class="table table-hover" id="tablaEventosAvisos">
              <thead>
                <tr>
                  <th style="width:65%;">Título</th>
                  <th>Modificado</th>
                </tr>
              </thead>
              <tbody>
                <% if(eventosAvisos.length == 0){%>
                <tr><td colspan="2">No existen registros</td></tr>
                <%}else{%>
                  <% eventosAvisos.forEach(item =>{ %>
                    <tr>
                      <td>
                        <a 
                        href="/imagenes/home/eventos_avisos/<%= item.archivo.nombre_archivo %>" 
                        target="_blank"
                        ><%= item.nombre_evento_aviso %></a></td><td><span class="date-badge"><%= item.f_modificacion === null ? 'Sin fecha de modificación' : item.f_modificacion %></span>
                      </td>
                    </tr>
                  <%});%>
                <%}%>
              </tbody>
            </table>
          </div>
        </div>

      </section>

      <script type="module">
        import {dataTable} from '/assets/js/dataTable.js';

        dataTable('tablaEventosAvisos')
      </script>