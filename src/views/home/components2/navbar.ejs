
    <style>
        /* Transiciones personalizadas para el offcanvas */
        .offcanvas-overlay {
            transition: opacity 0.3s ease-in-out;
        }
        
        .offcanvas-panel {
            transition: transform 0.3s ease-in-out;
        }
        
        .offcanvas-panel.from-left {
            transform: translateX(-100%);
        }
        
        .offcanvas-panel.from-right {
            transform: translateX(100%);
        }
        
        .offcanvas-panel.active {
            transform: translateX(0);
        }
        
        .offcanvas-overlay {
            opacity: 0;
            visibility: hidden;
        }
        
        .offcanvas-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        /* Prevenir scroll cuando el offcanvas está abierto */
        body.no-scroll {
            overflow: hidden;
        }
    </style>

    <!-- Navbar de ejemplo -->
    <nav class="bg-amarillo-claro shadow-lg sticky top-0 animate__animated animate__fadeIn">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <a href="/home" id="menuButtonLeft" class="text-rojo-claro text-xl font-bold no-underline hover:text-rojo-claro focus:outline-none focus:ring-2 rounded-lg p-2 transition-colors">
                        <i class="bi bi-house"></i> Inicio
                        </a>
                </div>
            </div>
        </div>
    </nav>


  