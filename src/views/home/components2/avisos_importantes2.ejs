<section class="w-full p-2">
    <div class="flex justify-between items-center mb-3 mt-3">
        <div class="flex justify-between items-center mb-3 mt-3"><h2 class="text-xl font-bold pl-3"><i class="bi bi-caret-right-fill"></i> Avisos Importantes</h2></div>
        <div class="border-b border-gray-200 my-2"></div>
    </div>

    <% if(avisosImportantes.length == 0) { %>
        <div class="bg-white-card text-center text-muted py-4 mb-4" style="font-size:.87rem;">
        <i class="bi bi-emoji-smile" style="font-size:2.5rem;color:#ccc;"></i>
        <p class="mt-2 mb-0">No hay Avisos Importantes Publicadas.</p>
        </div>
    <% } else { %>

    <div class="w-[100%] h-[300px] overflow-y-scroll">
    <% avisosImportantes.forEach(aviso=>{ %>
        <a class="no-underline flex justify-between items-center group border-l-8 border-b-2 border-r-2 border-t-2 border-rojo-oscuro pl-4 rounded-xl mb-2" href="<%= aviso.fk_id_pagina !== null ?'/'+ aviso.pagina.ruta_pag + '/' + aviso.pagina.nombre_pag : '#' %>">
            <div class="w-[100%] text-black ">
                <h4 class="text-xl font-bold"> <%=aviso.titulo%></h4>
                <p class="text-sm line-clamp-2"><i class="bi bi-dash-lg"></i> <%=aviso.descripcion%></p>
            </div>
            <i class="bi bi-arrow-right-short text-black text-2xl font-bold hidden group-hover:block"></i>
        </a>
    <%})%>
</div>
<% } %>
</section>