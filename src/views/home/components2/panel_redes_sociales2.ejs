<style>

    /* Demo content */
    .demo-content {
      max-width: 700px;
      margin: 0 auto;
      padding: 3rem 2rem;
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0,0,0,.08);
    }
    .demo-content h1 { font-size: 2rem; margin-bottom: 1rem; color: #111; }
    .demo-content p  { color: #555; line-height: 1.7; margin-bottom: 1rem; }

    /* ══════════════════════════════════════════
       BOTONES FLOTANTES — lado izquierdo
    ══════════════════════════════════════════ */
    .social-float {
      position: fixed;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 1000;
    }

    .sf-btn {
      display: flex;
      align-items: center;
      gap: 0;
      height: 44px;
      padding: 0;
      border: none;
      cursor: pointer;
      text-decoration: none;
      overflow: hidden;
      border-radius: 0 8px 8px 0;
      background: var(--brand);
      color: #fff;
      font-family: 'DM Sans', sans-serif;
      font-size: .85rem;
      font-weight: 600;
      white-space: nowrap;

      /* Sólo se ve el ícono; el label se expande en hover */
      width: 44px;
      transition: width .3s cubic-bezier(.4,0,.2,1),
                  box-shadow .2s,
                  transform .2s;
    }

    .sf-btn:hover {
      width: 155px;
      box-shadow: 4px 4px 16px -2px color-mix(in srgb, var(--brand) 55%, transparent);
      transform: translateX(2px);
    }

    .sf-btn .sf-icon {
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
    }
    .sf-btn .sf-icon svg {
      width: 20px;
      height: 20px;
      fill: #fff;
    }
    .sf-btn .sf-label {
      padding-right: 12px;
      opacity: 0;
      transition: opacity .2s .05s;
      pointer-events: none;
    }
    .sf-btn:hover .sf-label { opacity: 1; }

    /* Colores de marca */
    .sf-fb  { --brand: #1877f2; }
    .sf-ig  { --brand: #e1306c; background: linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); }
    .sf-tw  { --brand: #1da1f2; }
    .sf-wa  { --brand: #25d366; }
    .sf-yt  { --brand: #ff0000; }
    .sf-li  { --brand: #0a66c2; }
    .sf-tt  { --brand: #010101; }
    .sf-pi  { --brand: #e60023; }

    /* ══════════════════════════════════════════
       RESPONSIVO
       - < 768px : se ocultan los flotantes del lado
         y aparece una barra inferior centrada
    ══════════════════════════════════════════ */

    /* Barra inferior (oculta en desktop) */
    .social-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(15,15,15,.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255,255,255,.08);
      justify-content: center;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      z-index: 1000;
    }

    .sb-btn {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 10px;
      border: none;
      background: var(--brand);
      cursor: pointer;
      text-decoration: none;
      transition: transform .15s, opacity .15s;
      flex-shrink: 0;
    }
    .sb-btn svg { width: 20px; height: 20px; fill: #fff; }
    .sb-btn:active { transform: scale(.9); opacity: .8; }

    .sb-fb { --brand: #1877f2; }
    .sb-ig { --brand: #e1306c; background: linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); }
    .sb-tw { --brand: #1da1f2; }
    .sb-wa { --brand: #25d366; }
    .sb-yt { --brand: #ff0000; }
    .sb-li { --brand: #0a66c2; }

    /* ── breakpoint ── */
    @media (max-width: 768px) {
      .social-float { display: none; }   /* oculta lateral */
      .social-bar   { display: flex; }   /* muestra barra  */
      body { padding-bottom: 70px; }     /* espacio para barra */
    }

    /* Pantallas muy pequeñas: reduce tamaño íconos */
    @media (max-width: 380px) {
      .sb-btn { width: 36px; height: 36px; border-radius: 8px; }
      .sb-btn svg { width: 17px; height: 17px; }
      .social-bar { gap: 4px; padding: 8px 6px; }
    }

    /* Si la pantalla es muy angosta y no caben todos,
       se hace scroll horizontal en la barra */
    @media (max-width: 320px) {
      .social-bar {
        justify-content: flex-start;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .social-bar::-webkit-scrollbar { display: none; }
    }
  </style>

