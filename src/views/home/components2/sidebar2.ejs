    <!-- ─── LEFT SIDEBAR ─── -->
    <div class="col-lg-12 col-md-12">

      <div class="bg-white-card p-0 overflow-hidden">
        <% apartadosSubapartados.forEach(function(apartado){%>
          <%if(apartado.apartado.activo){%>
          <button class="smenu-btn" onclick="toggleMenu(this)">
            <i class="bi bi-info-circle smenu-icon"></i>
            <span class="smenu-label"><%=apartado.apartado.apartado%></span>
            <i class="bi bi-chevron-right smenu-arrow"></i>
          </button>
          <%}%>
          <% if(apartado.subapartado && apartado.subapartado.length > 0) { %>
          <div class="smenu-sub">
            <% apartado.subapartado.forEach(function(sub) { %>
              <% if (sub.activo) { %>
                  <a href="<%= sub.pagina !== null ?'/'+ sub.pagina.ruta_pag + '/' + sub.pagina.nombre_pag : '#' %>"><i class="bi bi-dot"></i><%=sub.subapartado %></a>
              <%}%>
            <%})%>
          </div>
          <%}%>  
        <%})%>

      </div>

      <div class="mt-3 text-center">
        <strong>
          <a href="#">
            Versión: 1.0.0
          </a>
        </strong>
      </div>
    </div>

    <script>
      function toggleMenu(btn) {
        const sub = btn.nextElementSibling;
        const isOpen = sub.classList.contains('open');

        // Close all open submenus
        document.querySelectorAll('.smenu-sub.open').forEach(el => {
          el.classList.remove('open');
        });
        document.querySelectorAll('.smenu-btn.open').forEach(el => {
          el.classList.remove('open');
        });

        // Open the clicked one (unless it was already open → toggle off)
        if (!isOpen) {
          sub.classList.add('open');
          btn.classList.add('open');
        }
      }
    </script>