<style>
    /* 
      IMPORTANTE: Para que el menú NO afecte a los elementos fuera de él,
      utilizamos un contenedor independiente que NO modifica el layout externo.
      El panel se posiciona de manera absoluta respecto a su contenedor relativo,
      así el contenido externo no se mueve/empuja al abrir/cerrar.
      El menú "flota" sobre el resto del contenido sin desplazar nada.
    */
    .menu-dropdown-container {
      position: relative;
      display: inline-block;
    }
    
    /* Panel flotante absoluto: No afecta flujo del documento, no mueve otros elementos */
    .menu-absolute-panel {
      position: absolute;
      top: calc(100% + 0.75rem);  /* separación del botón */
      right: 0;
      left: auto;
      width: min(92vw, 480px);    /* ancho adaptable: en móvil casi pantalla completa, desktop fijo */
      background: white;
      border-radius: 1.25rem;
      box-shadow: 0 25px 40px -12px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.02);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px) scale(0.96);
      transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      z-index: 9999;
      backdrop-filter: blur(0px);
      max-height: 85vh;
      overflow-y: auto;
      pointer-events: none;       /* mientras está oculto no bloquea clicks */
    }
    
    /* Panel abierto: visible y con interacción */
    .menu-absolute-panel.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
    
    /* Scroll personalizado dentro del menú para mejor UX */
    .menu-absolute-panel::-webkit-scrollbar {
      width: 5px;
    }
    .menu-absolute-panel::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 10px;
    }
    .menu-absolute-panel::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }
    
    /* Ajustes responsivos: en móvil el menú ocupará casi todo el ancho y se alinea a la derecha/inteligente */
    @media (max-width: 640px) {
      .menu-absolute-panel {
        width: calc(100vw - 2rem);
        left: 1rem;
        right: 1rem;
        top: calc(100% + 0.5rem);
        max-height: 75vh;
      }
    }
    
    /* Transiciones suaves para elementos internos */
    .nav-item-hover {
      transition: background 0.15s, padding-left 0.1s;
    }
    .nav-item-hover:hover {
      background-color: #f8fafc;
      padding-left: 0.5rem;
    }
    
    /* Fondo sutil overlay opcional? No para que no afecte elementos externos pero usamos solo panel flotante */
    body {
      background: linear-gradient(145deg, #f1f5f9 0%, #e6edf7 100%);
      min-height: 100vh;
    }
    
    /* Aseguramos que el contenedor del botón y el menú no afecten el layout general */
    header, main {
      position: relative;
      z-index: 1;
    }
    
    /* Botón sin efectos de desplazamiento colateral */
    #menuToggleBtn {
      transition: all 0.2s;
    }
    
    /* El contenido externo permanece estático, el menú no lo empuja */
  </style>
