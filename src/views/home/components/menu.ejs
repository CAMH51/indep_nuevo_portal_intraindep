     <script>
    (function() {
      const toggleBtn = document.getElementById('menuToggleBtn');
      const menuPanel = document.getElementById('menuPanel');
      const icon = document.getElementById('toggleIcon');
      let isOpen = false;

      // Función para abrir el menú (sin afectar elementos externos)
      function openMenu() {
        if (!menuPanel) return;
        menuPanel.classList.add('open');
        if (icon) icon.style.transform = 'rotate(180deg)';
        isOpen = true;
      }

      function closeMenu() {
        if (!menuPanel) return;
        menuPanel.classList.remove('open');
        if (icon) icon.style.transform = 'rotate(0deg)';
        isOpen = false;
      }

      function toggleMenu() {
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      }

      // Evento click en el botón principal
      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();  // Evita propagación indeseada
          toggleMenu();
        });
      }

      // Opcional: Cerrar menú al hacer clic fuera del panel, pero que NO afecte al resto de clicks normales.
      // Esto mejora la experiencia sin molestar los elementos externos (solo cuando está abierto)
      document.addEventListener('click', function(event) {
        if (!isOpen) return;
        // Si el clic no ocurre dentro del botón ni dentro del panel, se cierra.
        const isClickInsideBtn = toggleBtn && toggleBtn.contains(event.target);
        const isClickInsidePanel = menuPanel && menuPanel.contains(event.target);
        
        if (!isClickInsideBtn && !isClickInsidePanel) {
          closeMenu();
        }
      });

      // Cerrar con tecla ESC (tampoco afecta elementos externos)
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) {
          closeMenu();
        }
      });

      // Evitar que el scroll del body se active por el panel? No es necesario ya que el panel tiene max-height y overflow
      // También al hacer clic en enlaces internos del menú, se cierra automáticamente (para buena usabilidad)
      if (menuPanel) {
        const linksInside = menuPanel.querySelectorAll('a');
        linksInside.forEach(link => {
          link.addEventListener('click', () => {
            // Pequeño delay para que la navegación se sienta natural, pero cierra el menú
            setTimeout(() => {
              if (isOpen) closeMenu();
            }, 80);
          });
        });
      }
      
      // Prevenir cualquier posible evento que mueva el layout, confirmación de que el menú es posicionado de forma absoluta.
      // Ajuste responsivo: si redimensionas la ventana cuando el menú está abierto, sigue sin empujar.
      window.addEventListener('resize', () => {
        // Solo mantenemos la misma posición, no hay cambios de layout.
      });
    })();
  </script>