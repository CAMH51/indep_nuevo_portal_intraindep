<div class="flex justify-between p-2 bg-rojo-claro">
    <div id="fechaDisplay" class="text-amarillo-claro font-bold text-sm sm:text-base  px-3 py-2 rounded-full">
        <i class="bi bi-calendar"></i> <span id="fechaActual"></span>
    </div>
    <button id="loginBtn" class="bg-verde-oscuro text-white px-4 py-2 rounded-full font-bold hover:bg-verde-claro transition text-sm sm:text-base">
        <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
    </button>
</div>

<script>
    // Fecha actual
    const today = new Date();
    const optionsDate = { year: 'numeric', month: 'long', day: 'numeric' };
    document.getElementById('fechaActual').innerText = today.toLocaleDateString('es-ES', optionsDate);
    </script>
</script>