<style>
  .bday-section-header {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 12px;
  }
  .bday-section-header p {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #a08898;
    margin: 2px 0 0;
  }

  .bday-empty {
    padding: 40px 20px;
    text-align: center;
    color: #a08898;
    font-size: 14px;
  }
  .bday-empty span { font-size: 32px; display: block; margin-bottom: 8px; }

  /* ---- Swiper container ---- */
  .swiper {
    width: 100%;
    padding: 12px 4px 44px;
  }
  .swiper-slide {
    height: auto; /* deja que el flex del wrapper controle la altura */
    display: flex;
  }

  /* ---- Tarjeta moderna, tamaño fijo ---- */
  .bday-card-modern {
    width: 100%;
    min-height: 150px;
    background: #ffffff;
    border-radius: 20px;
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    border: 1px solid #f1e6ea;
    box-shadow:
      0 2px 4px rgba(0,0,0,.03),
      0 10px 24px rgba(155, 34, 71, .07);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .bday-card-modern:hover {
    transform: translateY(-4px);
    border-color: #e9c3ce;
    box-shadow:
      0 4px 10px rgba(0,0,0,.05),
      0 16px 32px rgba(155, 34, 71, .14);
  }

  .bday-avatar-modern {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(145deg, #7b1d3f 0%, #c0395e 60%, #e8607a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    letter-spacing: .5px;
    overflow: hidden;
    box-shadow: 0 6px 16px rgba(155, 34, 71, .25);
    flex-shrink: 0;
  }
  .bday-avatar-modern img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bday-nombre-modern {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a2e;
    line-height: 1.3;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bday-fecha-modern {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #faf4f6;
    border: 1px solid #f0dde4;
    border-radius: 50px;
    padding: 5px 13px;
    font-size: 11.5px;
    font-weight: 600;
    color: #8b2040;
    white-space: nowrap;
  }
  .bday-dot-modern {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c0395e;
    flex-shrink: 0;
  }

  /* ---- Flechas y paginación ---- */
  .swiper-button-next,
  .swiper-button-prev {
    color: #ffffff;
    background: linear-gradient(135deg, #a57f2c, #c99a3a);
    border-radius: 12px;
    width: 34px;
    height: 34px;
    box-shadow: 0 4px 10px rgba(165, 127, 44, .25);
  }
  .swiper-button-next:after,
  .swiper-button-prev:after {
    font-size: 14px;
    font-weight: bold;
  }
  .swiper-pagination-bullet {
    background: #dcc4cd;
    opacity: 1;
  }
  .swiper-pagination-bullet-active {
    background: #c0395e;
  }
</style>

<section class="w-full ">
  <div class="flex flex-column justify-center items-center">
    <div class="text-[#a57f2c] font-bold" id="bday-section-header"></div>
  </div>

  <div id="divCumplenios"></div>
</section>

<script >
  const cumpleanios = <%- JSON.stringify(cumpleanios) %>;
  const bdayInner = document.getElementById('divCumplenios');

  function semanaActual(fecha = new Date()) {
    const d = new Date(fecha);
    const dia = d.getDay();
    const diffLunes = (dia === 0 ? -6 : 1 - dia);
    const lunes = new Date(d);
    lunes.setDate(d.getDate() + diffLunes);
    lunes.setHours(0, 0, 0, 0);
    const domingo = new Date(lunes);
    domingo.setDate(lunes.getDate() + 6);
    domingo.setHours(23, 59, 59, 999);
    return { lunes, domingo };
  }

  function estaEnSemana(fechaStr) {
    const { lunes, domingo } = semanaActual();
    const hoy = new Date();
    const partes = fechaStr.split("-");
    const mes = parseInt(partes[1], 10) - 1;
    const dia = parseInt(partes[2], 10);
    const candidato = new Date(hoy.getFullYear(), mes, dia);
    return candidato >= lunes && candidato <= domingo;
  }

  function formatearFecha(fechaStr) {
    const meses = ["Enero","Febrero","Marzo","Abril","Mayo","Junio",
                   "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
    const partes = fechaStr.split("-");
    const mes = parseInt(partes[1], 10) - 1;
    const dia = partes[2];
    return `${meses[mes]}, ${dia}`;
  }

  function obtenerIniciales(nombreCompleto) {
    const palabras = nombreCompleto.trim().split(/\s+/);
    const inicial1 = palabras[0]?.[0]?.toUpperCase() ?? "";
    const inicial2 = palabras[1]?.[0]?.toUpperCase() ?? "";
    return inicial1 + inicial2;
  }

  const { lunes, domingo } = semanaActual();
  const fmt = d => d.toLocaleDateString("es-MX", { day: "2-digit", month: "short" });
  document.getElementById("bday-section-header").innerHTML =
    `<p>${fmt(lunes)} al ${fmt(domingo)}</p>`;

  const filtrados = cumpleanios.filter(c => estaEnSemana(c.f_nacimiento));
  let html = "";

  if (filtrados.length === 0) {
    bdayInner.innerHTML = `
      <div class="bday-empty">
        <span>🎈</span>
        <p>No hay cumpleaños esta semana.</p>
      </div>`;
  } else {
    html += `
    <div class="swiper mySwiper">
      <div class="swiper-wrapper">
    `;

    filtrados.forEach((c) => {
      const iniciales = obtenerIniciales(c.nombre + " " + c.ap_paterno);
      const fecha = formatearFecha(c.f_nacimiento);

      const avatarContent = c.fk_id_archivo !== null
        ? `<img src="/imagenes/home/cumpleanios/${c.archivo.nombre_archivo}" alt="img_avatar">`
        : iniciales;

      html += `
      <div class="swiper-slide">
        <div class="bday-card-modern">
          <div class="bday-avatar-modern">${avatarContent}</div>
          <h4 class="bday-nombre-modern">${c.nombre} ${c.ap_paterno}</h4>
          <span class="bday-fecha-modern">
            <span class="bday-dot-modern"></span>${fecha}
          </span>
        </div>
      </div>
      `;
    });

    html += `
      </div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-pagination"></div>
    </div>
    `;

    bdayInner.innerHTML = html;

    setTimeout(() => {
      if (typeof Swiper !== 'undefined') {
        new Swiper(".mySwiper", {
          spaceBetween: 16,
          slidesPerView: 1,
          autoplay: {
            delay: 2500,
            disableOnInteraction: false,
          },
          pagination: {
            el: ".swiper-pagination",
            clickable: true,
          },
          navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
          },
          breakpoints: {
            640:  { slidesPerView: 3, spaceBetween: 18 },
            1024: { slidesPerView: 4, spaceBetween: 20 },
          },
          loop: filtrados.length > 3,
        });
      }
    }, 100);
  }
</script>