<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal IntraINDEP</title>



    <link rel="stylesheet" href="/styles/home.css">
        <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="/styles/styles.css">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
     <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    />
</head>
<body>

   
        <div class="row container mx-auto " >
            <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                <%- include('./components2/top_bar.ejs') %>
            </div>
            <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                <%- include('./components2/header.ejs') %>
            </div>
            <div class="col-sm-12 col-md-12 col-xl-12">
                <%- include('./components2/navbar.ejs') %>
            </div>
        </div>

        <div class="row container mx-auto animate__animated animate__fadeIn">
            <div class="col-sm-12 col-md-12 col-xl-12 ">
                <%- include('./components2/avisos_importantes.ejs') %>
            </div>
        </div>

        <div class="container mx-auto">
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-3 col-xl-2 animate__animated animate__fadeIn">
                    <%- include('./components2/sidebar2.ejs') %>
                </div>
                <div class="col-sm-12 col-md-6 col-lg-6 col-xl-8">
                    <%if(isHome){%>
                    <div class="row">
                        <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                            <%- include('./components2/campania_interna.ejs') %>
                        </div>
                        <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                            <%- include('./components2/noticias.ejs') %>
                        </div>
                        <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                            <%- include('./components2/serviciosPromociones.ejs') %>
                        </div>
                        <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                            <%- include('./components2/eventos_avisos.ejs') %>
                        </div>
                        <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                            <%- include('./components2/cumpleanios2.ejs') %>
                        </div>
                        <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                            <%- include('./components2/fotogaleria.ejs') %>
                        </div>
                        <div class="col-sm-12 col-md-12 col-xl-12 animate__animated animate__fadeIn">
                            <%- include('./components2/mapa.ejs') %>
                        </div>
                        <%- include('./components2/ventana_emergente.ejs') %>
                    </div>
                    <%}else{%>
                    <div class="col-sm-12 col-md-12 ">

                        <nav class="flex mt-4" aria-label="Breadcrumb">
                            <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
                                <li class="inline-flex items-center">
                                <a href="/home" class="inline-flex items-center text-sm font-medium text-body ">
                                    <svg class="w-4 h-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m4 12 8-8 8 8M6 10.5V19a1 1 0 0 0 1 1h3v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h3a1 1 0 0 0 1-1v-8.5"/></svg>
                                    Home
                                </a>
                                </li>
                                <li>
                                <% if(apartado) { %>
                                <div class="flex items-center space-x-1.5">
                                    <svg class="w-3.5 h-3.5 rtl:rotate-180 text-body" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/></svg>
                                    <span class="inline-flex items-center text-sm font-medium text-body-subtle"><%= apartado %></span>
                                </div>
                                <% } %>
                                </li>
                                <li aria-current="page">
                                <% if(slug) { %>
                                <div class="flex items-center space-x-1.5">
                                    <svg class="w-3.5 h-3.5 rtl:rotate-180 text-body" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/></svg>
                                    <span class="inline-flex items-center text-sm font-medium text-body-subtle"><%= slug %></span>
                                </div>
                                <% } %>
                                </li>
                            </ol>
                        </nav>
                        <% if (typeof pageHtml !== 'undefined') { %>
                            <%- pageHtml %>
                        <% } else { %>
                            <% try { %>
                                <%- include('../' + page) %>
                            <% } catch(e) { %>
                                <%- include('./404.ejs') %>
                            <% } %>
                        <% } %>
                    </div>

                    <%}%>
                </div>
                <div class="col-sm-12 col-md-3 col-lg-3 col-xl-2 animate__animated animate__fadeIn">
                    <%- include('./components2/accesosRapidos2.ejs') %>
                </div>
            </div>
        </div>
        <div id="redes_sociales" class="">
            <%- include('./components2/panel_redes_sociales2.ejs') %>
        </div>
        <%- include('./components2/top_button.ejs') %>
        <div class="row container mx-auto">
            <%- include('./components2/footer.ejs') %>

        </div>

</body>
</html>