<div class="field">
    <div class="flex flex-col mb-3">
        <label class="text-1xl font-bold text-amarillo-oscuro p-2" for=""><%=titulo%></label>
        <select class="border border-2 border-amarillo-oscuro p-3 bg-gray-100 rounded-xl focus:outline-none focus:border-amarillo-claro focus:bg-white" name="<%=name%>" id="<%=id%>">
            <option value="" selected><%=texto%></option>
            <% opciones.forEach(opcion => { %>
            <option value="<%=opcion[opcionId]%>"><%=opcion[opcionNombre]%></option>
            <% }); %>
        </select>
        <p class="msg"></p>
    </div>
</div>