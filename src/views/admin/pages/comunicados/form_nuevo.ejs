<div class="shadow-lg p-4 bg-white  p-4 rounded-xl bg-white h-[700px] overflow-hidden">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-plus-circle"></i> Nuevo Comunicado</p>
    <div class="h-[600px] overflow-x-scroll">
        <form id="formComunicado">
            <%- include('../../components/inputFile',{
                formato:'JPG, PNG, GIF', 
                id:'imgComunicado', 
                name:'imgComunicado', 
                titulo:'Imagen del comunicado'}) 
            %>

            <%- include('../../components/select',{
                titulo:'Departamento Comunicado:',
                texto:'Seleccione una Departamento:' ,
                id:'departamento_comunicado', 
                name:'departamento_comunicado',
                opciones:departamentos, 
                opcionId:'id_departamento_comunicado',
                opcionNombre:'titulo'}) 
            %>
            <%- include('../../components/select',{
                titulo:'Asociar una página a la noticia (opcional):',
                texto:'Seleccione una página:', 
                id:'pagina',
                name:'pagina',
                opciones:paginas, 
                opcionId:'id_pagina',
                opcionNombre:'nombre_pag'}) 
            %>
            <%- include('../../components/input',{
                titulo:'URL Comunicado (opcional):', 
                type:'text', 
                id:'url_comunicado', 
                name:'url_comunicado', 
                placeholder:'URL Comunicado'}) 
            %>
    
            <%- include('../../components/btnGuardar',{
                texto:'Guardar Comunicado', 
                type:'submit', 
                id:'btnGuardarComunicado'}) 
            %>
        </form>
    </div>
</div>
<%- include('../../components/scriptValidator.ejs',{}) %>
<script >

    const validarComunicado=[
        {name:'imgComunicado', validate:'required|file_max:5|file_type:image/png,image/jpeg,image/webp'},
        {name:'departamento_comunicado', validate:'required'}
    ];

    const formComunicado = document.getElementById('formComunicado');

    formComunicado.addEventListener('submit', async (e) => {
        e.preventDefault();
        const { valid } = validateAll(validarComunicado);

        if(valid){
            const formData = new FormData(formComunicado);

            const response =await fetch('/comunicados?uploadPath=/home/comunicados&fieldName=imgComunicado',{
                method: 'POST',
                body: formData
            }); 

            const data = await response.json();

            if(response.ok){
                refrescarTabla('#tablaComunicados')
                    clearAllFiles();
                    formComunicado.reset();
                    document.querySelectorAll('.msg').forEach(el => {
                        el.className = 'msg';
                        el.innerHTML = '';
                    });

                    // Remover clases de error/éxito de todos los campos
                    document.querySelectorAll('.field').forEach(el => {
                        el.classList.remove('border-red-500', 'border-green-500', 'is-invalid', 'is-valid');
                    });
                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Registro agregado con éxito",
                        showConfirmButton: false,
                        timer: 1500
                    });
            }
        }

    })

</script>