<div class="shadow-lg p-4 bg-white  p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado de Subapartados</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../../components/table',{idTable:'tablaSubapartados'}) %>
        <%- include('../../../components/scriptDataTable') %>
    </div>

</div>

<%- include('../../../components/modal',{idModal:"modalSubapartado", titulo:"Editar Subapartado",body:'../pages/catalogos/subapartados/form_editar.ejs'}) %>
<script >

    const columnasTableSubapartados=[
        {title:'Id',data:'id_subapartado'},
        {title:'Nombre',data:'subapartado'},
        {title:'Descripcion',data:'descripcion'},
        {title:'Apartado',data:'fk_id_apartado'},
        {title:'Página asociada',data:'fk_id_pagina'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                if(row.activo){
                    return `
                        <a title="Editar" onclick="openModal(${row.id_subapartado},obtenerSubapartado)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarSubapartado(${row.id_subapartado},'false')" title="Desactivar Subapartado" class="text-xl text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    return `
                        <a  title="Editar" onclick="openModal(${row.id_subapartado},obtenerSubapartado)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarSubapartado(${row.id_subapartado},'true')" title="Activar Subapartado" class="text-xl text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
            }
        },

    ];

     const id_user = <%= id_user %>;

    verTabla(columnasTableSubapartados,{},'#tablaSubapartados','/apartados/subapartados/'+id_user);

    async function  obtenerSubapartado(id){
        const response = await fetch(`/subapartados/${id}`);
        const data = await response.json();
        if(data.success){
            document.getElementById('id_subapartado').value = data.data.id_subapartado;
            document.getElementById('editSubapartado').value = data.data.subapartado;
            document.getElementById('editDescripcion').value = data.data.descripcion;
            document.getElementById('editFkIdApartado').value = data.data.fk_id_apartado;
            document.getElementById('editFkIdPagina').value = data.data.fk_id_pagina;
        }
    }

    async function activarSubapartado(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/subapartados/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        refrescarTabla('#tablaSubapartados')
    }

    closeModalBtn.addEventListener('click', closeModal);

    

</script>