<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado de Roles</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../../components/table',{idTable:'tablaRoles'}) %>
        <%- include('../../../components/scriptDataTable') %>
    </div>

</div>

<%- include('../../../components/modal',{idModal:"modalRol", titulo:"Editar Rol",body:'../pages/catalogos/roles/form_editar.ejs'}) %>
<script >

    async function roles(){
        const response = await fetch('/roles/all');
        const data = await response.json();
        console.log('Roles'.data);
    }

    const columnasTableRoles=[
        {title:'Id',data:'id_rol'},
        {title:'Nombre',data:'rol'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                if(row.activo){
                    return `
                        <a title="Editar" onclick="openModal(${row.id_rol},obtenerRol)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarRol(${row.id_rol},'false')" title="Desactivar Etiqueta" class="text-xl text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    return `
                        <a  title="Editar" onclick="openModal(${row.id_rol},obtenerRol)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarRol(${row.id_rol},'true')" title="Activar Etiqueta" class="text-xl text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
            }
        },

    ];

    verTabla(columnasTableRoles,{},'#tablaRoles','/roles/all');

    async function obtenerRol(id){
        const response = await fetch(`/roles/${id}`);
        const data = await response.json();
        console.log('editRol',data);
        if(data.success){
            document.getElementById('id_rol').value = data.data.id_rol;
            document.getElementById('editRol').value = data.data.rol;
        }
    }

    async function activarRol(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/roles/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        refrescarTabla('#tablaRoles')
    }

    closeModalBtn.addEventListener('click', closeModal);

    

</script>