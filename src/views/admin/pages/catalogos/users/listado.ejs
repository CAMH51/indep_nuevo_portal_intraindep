<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado de Usuarios</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../../components/table',{idTable:'tablaUsuarios'}) %>
        <%- include('../../../components/scriptDataTable') %>
    </div>

</div>

<%- include('../../../components/modal',{idModal:"modalUsuarios", titulo:"Editar Usuario", body:'../pages/catalogos/users/form_editar.ejs', maxWidth:'max-w-3xl'}) %>

<script >

    const columnasTableUsuarios=[
        {title:'Id',data:'id_user'},
        {title:'Correo Electrónico',data:'email'},
        {title:'Creado por',data:'created_by'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                if(row.activo){
                    return `
                        <a title="Editar" onclick="openModal(${row.id_user},obtenerUsuario)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarUsuario(${row.id_user},'false')" title="Desactivar Usuario" class="text-xl text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    return `
                        <a  title="Editar" onclick="openModal(${row.id_user},obtenerUsuario)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarUsuario(${row.id_user},'true')" title="Activar Usuario" class="text-xl text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
            }
        },

    ];

    verTabla(columnasTableUsuarios,{},'#tablaUsuarios','/users/user');

    async function obtenerUsuario(id){
        const response = await fetch(`/users/${id}`);
        const data = await response.json();
        if(data.success && data.data){
            document.getElementById('id_user').value = data.data.id_user;
            document.getElementById('id_user').dataset.createdBy = data.data.created_by || '';
            document.getElementById('editEmail').value = data.data.email;
            document.getElementById('editFkIdRol').value = data.data.fk_id_rol;

            if (typeof cargarApartadosYModulos === 'function') {
                await cargarApartadosYModulos(data.data.id_user, data.data.fk_id_rol, data.data.created_by);
            }
        }
    }


    async function activarUsuario(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/users/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        refrescarTabla('#tablaUsuarios')
    }

    closeModalBtn.addEventListener('click', closeModal);

    

</script>