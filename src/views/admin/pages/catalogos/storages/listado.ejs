<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado de Storages</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../../components/table',{idTable:'tablaStorages'}) %>
        <%- include('../../../components/scriptDataTable') %>
    </div>

</div>

<%- include('../../../components/modal',{idModal:"modalStorage", titulo:"Editar Storage",body:'../pages/catalogos/storages/form_editar.ejs'}) %>
<script >

    const columnasTableStorages=[
        {title:'Id',data:'id_storage'},
        {title:'Nombre',data:'name'},
        {title:'Ruta',data:'base_path'},
        {title:'Directorio Principal',data:'directorio_principal'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                if(row.activo){
                    return `
                        <a title="Editar" onclick="openModal(${row.id_storage},obtenerStorage)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarStorage(${row.id_storage},'false')" title="Desactivar Storage" class="text-xl text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    return `
                        <a  title="Editar" onclick="openModal(${row.id_storage},obtenerStorage)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarStorage(${row.id_storage},'true')" title="Activar Storage" class="text-xl text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
            }
        },

    ];

    verTabla(columnasTableStorages,{},'#tablaStorages','/storages/all');

    async function  obtenerStorage(id){
        const response = await fetch(`/storages/${id}`);
        const data = await response.json();
        if(data.success){
            document.getElementById('id_storage').value = data.data.id_storage;
            document.getElementById('editName').value = data.data.name;
            document.getElementById('editBasePath').value = data.data.base_path;
            document.getElementById('editDirectorioPrincipal').value = data.data.directorio_principal;
        }
    }

    async function activarStorage(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/storages/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        refrescarTabla('#tablaStorages')
    }

    closeModalBtn.addEventListener('click', closeModal);

    

</script>