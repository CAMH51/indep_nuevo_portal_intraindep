<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-plus-circle"></i> Nueva Etiqueta</p>
    <form id="formEtiqueta">
        <%- include('../../../components/input',{
            titulo:'Nombre de la etiqueta:', 
            type:'text', id:'etiqueta', 
            name:'etiqueta', 
            placeholder:'Título de la etiqueta'}) 
        %>
        <div id="errorEtiqueta">

        </div>
        <%- include('../../../components/btnGuardar',{
            texto:'Guardar Etiqueta', 
            type:'submit', 
            id:'btnGuardarEtiqueta'}) 
        %>
    </form>
</div>

<%- include('../../../components/scriptValidator.ejs',{}) %>

<script >

    const validarEtiqueta =[
        {name:'etiqueta', validate:'required|min:5'}
    ];

    const formEtiqueta = document.getElementById('formEtiqueta');

    formEtiqueta.addEventListener('submit', async (e) => {
        e.preventDefault();
        const { valid } = validateAll(validarEtiqueta);
        
        if(valid){
            
            const formData = new FormData(formEtiqueta);
            formData.append('fk_id_user',1);
    
            const response =await fetch('/etiquetas',{
                method: 'POST',
                body: formData
            }); 
    
            const data = await response.json();
    
            if(data.success){
                // Si solo quieres recargar los datos actuales
                refrescarTabla('#tablaEtiquetas')
                formEtiqueta.reset();
                Swal.fire({
                    position: "top-end",
                    icon: "success",
                    title: "Registro agregado con éxito",
                    showConfirmButton: false,
                    timer: 1500
                });
            }
        }

    });

</script>