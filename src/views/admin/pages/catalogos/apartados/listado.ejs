<div class="shadow-lg p-4 bg-white  p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado de Apartados</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../../components/table',{idTable:'tablaApartados'}) %>
        <%- include('../../../components/scriptDataTable') %>
    </div>

</div>

<%- include('../../../components/modal',{idModal:"modalApartado", titulo:"Editar Apartado",body:'../pages/catalogos/apartados/form_editar.ejs'}) %>
<script >

    const columnasTableApartados=[
        {title:'Id',data:'id_apartado'},
        {title:'Nombre',data:'apartado'},
        {title:'Descripcion',data:'descripcion'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                if(row.activo){
                    return `
                        <a title="Editar" onclick="openModal(${row.id_apartado},obtenerApartado)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarApartado(${row.id_apartado},'false')" title="Desactivar Apartado" class="text-xl text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    return `
                        <a  title="Editar" onclick="openModal(${row.id_apartado},obtenerApartado)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarApartado(${row.id_apartado},'true')" title="Activar Apartado" class="text-xl text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
            }
        },

    ];

    const id_user = <%= id_user %>;

    verTabla(columnasTableApartados,{},'#tablaApartados','/apartados/asignados/'+id_user);

    async function  obtenerApartado(id){
        const response = await fetch(`/apartados/${id}`);
        const data = await response.json();
        if(data.success){
            document.getElementById('id_apartado').value = data.data.id_apartado;
            document.getElementById('editApartado').value = data.data.apartado;
            document.getElementById('editDescripcion').value = data.data.descripcion;
        }
    }

    async function activarApartado(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/apartados/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        refrescarTabla('#tablaApartados')
    }

    closeModalBtn.addEventListener('click', closeModal);

    

</script>