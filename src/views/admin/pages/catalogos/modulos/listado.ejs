<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado de Módulos</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../../components/table',{idTable:'tablaModulos'}) %>
        <%- include('../../../components/scriptDataTable') %>
    </div>

</div>

<%- include('../../../components/modal',{idModal:"modalModulo", titulo:"Editar Módulo",body:'../pages/catalogos/modulos/form_editar.ejs'}) %>
<script >

    const columnasTableModulos=[
        {title:'Id',data:'id_modulo'},
        {title:'Módulo',data:'modulo'},
        {title:'Nombre',data:'nombre'},
        {title:'Descripcion',data:'descripcion'},
        {title:'Ruta',data:'ruta'},
        {title:'Catalogo',data:'iscatalog'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                if(row.activo){
                    return `
                        <a title="Editar" onclick="openModal(${row.id_modulo},obtenerModulo)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarModulo(${row.id_modulo},'false')" title="Desactivar Módulo" class="text-xl text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    return `
                        <a  title="Editar" onclick="openModal(${row.id_modulo},obtenerModulo)" class="text-xl text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>
                        <a onclick="activarModulo(${row.id_modulo},'true')" title="Activar Módulo" class="text-xl text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
            }
        },

    ];

    verTabla(columnasTableModulos,{},'#tablaModulos','/modulos/all');

    async function  obtenerModulo(id){
        const response = await fetch(`/modulos/${id}`);
        const data = await response.json();
        if(data.success){
            document.getElementById('id_modulo').value = data.data.id_modulo;
            document.getElementById('editModulo').value = data.data.modulo;
            document.getElementById('editNombre').value = data.data.nombre;
            document.getElementById('editDescripcion').value = data.data.descripcion;
            document.getElementById('editRuta').value = data.data.ruta;
            data.data.iscatalog ? document.getElementById('editIscatalog').setAttribute('checked',true) : document.getElementById('editIscatalog').removeAttribute('checked');
            openModal();
        }
    }

    async function activarModulo(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/modulos/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        refrescarTabla('#tablaModulos')
    }

    closeModalBtn.addEventListener('click', closeModal);

    

</script>