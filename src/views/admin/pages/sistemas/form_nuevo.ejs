<div class="shadow-lg p-4 bg-white  p-4 rounded-xl bg-white h-[700px] overflow-hidden">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-plus-circle"></i> Nuevo Sistema</p>
    <div class="h-[600px] overflow-x-scroll">
        <form id="formSistema">
            <%- include('../../components/input',{
                titulo:'Nombre del sistema:', 
                type:'text', 
                id:'nombre_sistema', 
                name:'nombre_sistema', 
                placeholder:'Ingresa el nombre del sistema'}); 
            %>

            <%- include('../../components/input',{
                titulo:'Siglas del sistema', 
                type:'text', 
                id:'siglas', 
                name:'siglas', 
                placeholder:'Ingresa las siglas del sistema'}); 
            %>

            <%- include('../../components/input',{
                titulo:'URL del sistema', 
                type:'text', 
                id:'url_sistema', 
                name:'url_sistema', 
                placeholder:'Ingresa la URL del sistema'}); 
            %>

            <%- include('../../components/textarea',{
                titulo:'Descripción del sistema:', 
                id:'descripcion', 
                name:'descripcion', 
                placeholder:'Descripción del sistema'}) 
            %>

            <%- include('../../components/btnGuardar',{
                texto:'Guardar Sistema', 
                type:'submit', 
                id:'btnGuardarSistema'}); 
            %>
        </form>
    </div>
</div>
<%- include('../../components/scriptValidator.ejs',{}) %>
<script >

    const validarSistema=[
        {name:'nombre_sistema', validate:'required'},
        {name:'url_sistema', validate:'required'}
    ];

    const formSistema = document.getElementById('formSistema');

    formSistema.addEventListener('submit', async (e) => {
        e.preventDefault();
        const { valid } = validateAll(validarSistema);

        if(valid){
            const formData = new FormData(formSistema);

            const response =await fetch('/sistemas',{
                method: 'POST',
                body: formData
            }); 

            const data = await response.json();

            if(response.ok){
                refrescarTabla('#tablaSistemas')
                    formSistema.reset();
                    document.querySelectorAll('.msg').forEach(el => {
                        el.className = 'msg';
                        el.innerHTML = '';
                    });

                    // Remover clases de error/éxito de todos los campos
                    document.querySelectorAll('.field').forEach(el => {
                        el.classList.remove('border-red-500', 'border-green-500', 'is-invalid', 'is-valid');
                    });
                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Registro agregado con éxito",
                        showConfirmButton: false,
                        timer: 1500
                    });
            }
        }

    })

</script>