<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado del Cumpleaños</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../components/table',{idTable:'tablaCumpleanio'}) %>
        <%- include('../../components/scriptDataTable') %>
    </div>
</div>

<%- include('../../components/modal',{idModal:"modalCumpleanio", titulo:"Editar Cumpleaños",body:'../pages/cumpleanios/form_editar.ejs'}) %>

<script >

    //columnas de la tabla 
    const columnasTableCumpleanios=[
        {title:'Id',data:'id_cumpleanio',width:'50px',className:'text-center'},
        {title:'Archivo',data:'archivo.nombre_archivo',width:'300px',
            render:function(data,type,row,meta){
                return `
                    <span class="inline-flex items-center rounded-md bg-cyan-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-cyan-700/10">
                        ${data}
                    </span>
                `
            }
        },
        {title:'Nombre',data:'nombre',width:'100px'},
        {title:'Ap. Paterno',data:'ap_paterno',width:'100px'},
        {title:'Ap. Materno',data:'ap_materno',width:'100px'},
        {title:'Fecha de nacimiento',data:'f_nacimiento',width:'100px'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                let html = "";
                html += `<a onclick="openModal(${row.id_cumpleanio},obtenerCumpleanio)" class="text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>`;
                if(row.activo){
                    html +=`
                        <a onclick="activarCumpleanio(${row.id_cumpleanio},'false')" class="text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    html += `
                        <a onclick="activarCumpleanio(${row.id_cumpleanio},'true')" class="text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
                return html;
            }
        },

    ];


    /*
        función verTabla que se encuentra en la vista del componente table 
        verTabla(Columnas,id de la tabla,ruta de los datos);
    */

    verTabla(columnasTableCumpleanios,{},'#tablaCumpleanio','/cumpleanios/user/<%=id_user%>');

    /*
        Función para obtener los datos de los cumpleanios a editar, pasando el id de dicho cumpleanios.
        En las columnas se pasa un link con un onclick y la funcion openModal con los parametros del id del cumpleanios y la funcion obtenerCumpleanio que es un callback
    */

    async function  obtenerCumpleanio(id){
        const response = await fetch(`/cumpleanios/${id}`);
        const data = await response.json();
        if(data.success){
            document.getElementById('id_cumpleanio').value = data.data.id_cumpleanio;
            document.getElementById('badgeCumpleanio').textContent =data.data.fk_id_archivo !== null ? data.data.archivo.nombre_archivo : 'N/A';
            document.getElementById('editNombre').value = data.data.nombre;
            document.getElementById('editApPaterno').value = data.data.ap_paterno;
            document.getElementById('editApMaterno').value = data.data.ap_materno;
            document.getElementById('editFNacimiento').value = data.data.f_nacimiento;
        }
    }

    /*
        función que llama a la ruta activar y manda el estatus para activar o desactivar la noticia.
    */
    async function activarCumpleanio(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/cumpleanios/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        //Esta funcion viene de la vista table y refresca eb tiempo real la tabla
        refrescarTabla('#tablaCumpleanio')
    }

    closeModalBtn.addEventListener('click',()=>{
            // Limpiar todos los mensajes de error
        document.querySelectorAll('.msg').forEach(el => {
            el.className = 'msg';
            el.innerHTML = '';
        });

        // Remover clases de error/éxito de todos los campos
        document.querySelectorAll('.field').forEach(el => {
            el.classList.remove('border-red-500', 'border-green-500', 'is-invalid', 'is-valid');
        });
        clearAllFilesEdit();
        closeModal();
    });
</script>