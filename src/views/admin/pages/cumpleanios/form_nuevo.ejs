<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white h-[700px] overflow-hidden">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-plus-circle"></i> Nuevo Cumpleaños</p>
    <div class="h-[600px] overflow-x-scroll">
        <form id="formCumpleanio">
            <%- include('../../components/inputFile',{
                formato:'JPG, PNG, GIF', 
                id:'imgCumpleanio', 
                name:'imgCumpleanio', 
                titulo:'Imagen del Cumpleañero'}) 
            %>

            <%- include('../../components/input',{
                titulo:'Nombre:', 
                type:'text', 
                id:'nombre', 
                name:'nombre', 
                placeholder:'Nombre'}) 
            %>

            <%- include('../../components/input',{
                titulo:'Ap. Paterno:', 
                type:'text', 
                id:'ap_paterno', 
                name:'ap_paterno', 
                placeholder:'Apellido Paterno'}) 
            %>

            <%- include('../../components/input',{
                titulo:'Ap. Materno (Opcional):', 
                type:'text', 
                id:'ap_materno', 
                name:'ap_materno', 
                placeholder:'Apellido Materno'}) 
            %>

            <%- include('../../components/input',{
                titulo:'Fecha de Nacimiento:', 
                type:'date', 
                id:'f_nacimiento', 
                name:'f_nacimiento', 
                placeholder:'Fecha de Nacimiento'}) 
            %>
    
            <%- include('../../components/btnGuardar',{
                texto:'Guardar Cumpleaños', 
                type:'submit', 
                id:'btnGuardarCumpleanio'}) 
            %>
        </form>
    </div>
</div>
<%- include('../../components/scriptValidator.ejs',{}) %>
<script >

    const validarCumpleanios=[
        {name:'imgCumpleanio', validate:'file_max:5|file_type:image/png,image/jpeg,image/webp'},
        {name:'nombre', validate:'required'},
        {name:'ap_paterno', validate:'required'},
        {name:'f_nacimiento', validate:'required'},
    ];

    const formCumpleanio = document.getElementById('formCumpleanio');

    formCumpleanio.addEventListener('submit', async (e) => {
        e.preventDefault();
        const { valid } = validateAll(validarCumpleanios);

        if(valid){
            const formData = new FormData(formCumpleanio);

            const response =await fetch('/cumpleanios?uploadPath=/home/cumpleanios&fieldName=imgCumpleanio',{
                method: 'POST',
                body: formData
            }); 

            const data = await response.json();

            if(response.ok){
                refrescarTabla('#tablaCumpleanio')
                    clearAllFiles();
                    formCumpleanio.reset();
                    document.querySelectorAll('.msg').forEach(el => {
                        el.className = 'msg';
                        el.innerHTML = '';
                    });

                    // Remover clases de error/éxito de todos los campos
                    document.querySelectorAll('.field').forEach(el => {
                        el.classList.remove('border-red-500', 'border-green-500', 'is-invalid', 'is-valid');
                    });
                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Registro agregado con éxito",
                        showConfirmButton: false,
                        timer: 1500
                    });
            }
        }

    })

</script>