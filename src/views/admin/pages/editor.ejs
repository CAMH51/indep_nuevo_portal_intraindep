    }
    
    const fontSize = getLinkStyleValue('fontSize', '');
    const fontSizeNum = parseInt(fontSize) || 14;
    const fontFamily = getLinkStyleValue('fontFamily', '');
    const color = getLinkStyleValue('color', '#1a6cf0');
    const bgColor = getLinkStyleValue('backgroundColor', 'transparent');
    const textAlign = getLinkStyleValue('textAlign', 'left');
    const textDecoration = getLinkStyleValue('textDecoration', 'underline');
    const fontWeight = getLinkStyleValue('fontWeight', 'normal');
    const fontStyle = getLinkStyleValue('fontStyle', 'normal');
    
    const align = wrap ? wrap.style.justifyContent || 'flex-start' : 'flex-start';

    html += `
    <p class="pp-sec">Archivo</p>
    <div class="pp-row"><span class="pp-label">Subir archivo</span></div>
    <input type="file" class="pp-input" style="margin-bottom:12px" onchange="uploadFile(this)" accept=".pdf, .doc, .docx, .xls, .xlsx, .ppt, .pptx, .txt, .rtf"/>
    
    <div class="pp-row"><span class="pp-label">URL / Ruta</span></div>
    <input type="text" class="pp-input mono" style="margin-bottom:12px;width:100%" value="${escapeHtml(link?.getAttribute('href') || '')}"
      onchange="setPropAttr('a','href',this.value)" placeholder="ruta/archivo.pdf"/>
    
    <div class="pp-row"><span class="pp-label">Texto</span></div>
    <input type="text" class="pp-input" style="margin-bottom:12px;width:100%" value="${escapeHtml(link?.textContent || '')}"
      oninput="setPropTextContent('a',this.value)" placeholder="Texto del enlace"/>
    
    <p class="pp-sec">Alineación</p>
    <div class="pp-row">
      <div class="pp-btns" style="width:100%">
        <button class="pp-btn ${align === 'flex-start' ? 'on' : ''}" onclick="setFileAlign('flex-start')">⬱ Izquierda</button>
        <button class="pp-btn ${align === 'center' ? 'on' : ''}" onclick="setFileAlign('center')">☰ Centro</button>
        <button class="pp-btn ${align === 'flex-end' ? 'on' : ''}" onclick="setFileAlign('flex-end')">⬰ Derecha</button>
      </div>
    </div>
    
    <p class="pp-sec">Tipografía</p>
    <div class="pp-row"><span class="pp-label">Tamaño</span>
      <input type="number" class="pp-input" style="width:70px" value="${fontSizeNum}"
        oninput="setPropTagStyle('a', 'fontSize', this.value ? this.value+'px' : '')"
        onchange="setPropTagStyle('a', 'fontSize', this.value ? this.value+'px' : '')"/></div>
    <div class="pp-row"><span class="pp-label">Familia</span>
      <select class="pp-select" onchange="setPropTagStyle('a', 'fontFamily', this.value)">
        <option value="">Por defecto</option>
        <option value="'Outfit', sans-serif" ${fontFamily.includes('Outfit') ? 'selected' : ''}>Outfit</option>
        <option value="'Noto Sans Regular', sans-serif" ${fontFamily.includes('Noto Sans') ? 'selected' : ''}>Noto Sans Regular</option>
        <option value="Georgia, serif" ${fontFamily.includes('Georgia') ? 'selected' : ''}>Georgia</option>
        <option value="'Courier New', monospace" ${fontFamily.includes('Courier') ? 'selected' : ''}>Courier New</option>
        <option value="Arial, sans-serif" ${fontFamily.includes('Arial') ? 'selected' : ''}>Arial</option>
        <option value="'Times New Roman', serif" ${fontFamily.includes('Times') ? 'selected' : ''}>Times New Roman</option>
        <option value="Verdana, sans-serif" ${fontFamily.includes('Verdana') ? 'selected' : ''}>Verdana</option>
      </select></div>
    
    <div class="pp-row"><span class="pp-label">Estilo</span>
      <div class="pp-btns">
        <button class="pp-btn ${fontWeight === 'bold' ? 'on' : ''}" 
          onclick="toggleFileStyle('fontWeight', 'bold', 'normal')"><b>B</b></button>
        <button class="pp-btn ${fontStyle === 'italic' ? 'on' : ''}" 
          onclick="toggleFileStyle('fontStyle', 'italic', 'normal')"><i>I</i></button>
        <button class="pp-btn ${textDecoration !== 'underline' && textDecoration !== '' ? 'on' : ''}" 
          onclick="toggleFileUnderline()"><u>U</u></button>
      </div></div>
    
    <div class="pp-row"><span class="pp-label">Colores</span></div>
    <div class="pp-row"><span class="pp-label">Texto</span>
      <input type="color" class="pp-color" value="${rgbToHex(color)}"
        oninput="setPropTagStyle('a','color',this.value)"
        onchange="setPropTagStyle('a','color',this.value)"/></div>
    <div class="pp-row"><span class="pp-label">Fondo</span>
      <input type="color" class="pp-color" value="${rgbToHex(bgColor)}"
        oninput="setPropTagStyle('a','backgroundColor',this.value)"
        onchange="setPropTagStyle('a','backgroundColor',this.value)"/></div>`;
  }
  else if (isLink || isButton) {
    const link = block.querySelector('a');
    html += `
      <p class="pp-sec">Enlace</p>
      <div class="pp-row"><span class="pp-label">URL</span></div>
      <input type="text" class="pp-input mono" style="margin-bottom:12px;width:100%" value="${link?.href || ''}"
        onchange="setPropAttr('a','href',this.value)" placeholder="https://..."/>
      <div class="pp-row"><span class="pp-label">Texto</span></div>
      <input type="text" class="pp-input" style="margin-bottom:12px;width:100%" value="${link?.textContent || ''}"
        oninput="setPropTextContent('a',this.value)" placeholder="Texto del enlace"/>
      ${isButton ? `
      <div class="pp-row"><span class="pp-label">Color botón</span>
        <input type="color" class="pp-color" value="${rgbToHex(link?.style.backgroundColor) || '#1a1a1a'}"
          oninput="setPropTagStyle('a','backgroundColor',this.value)"
          onchange="setPropTagStyle('a','backgroundColor',this.value)"/></div>
      <div class="pp-row"><span class="pp-label">Color texto</span>
        <input type="color" class="pp-color" value="${rgbToHex(link?.style.color) || '#ffffff'}"
          oninput="setPropTagStyle('a','color',this.value)"
          onchange="setPropTagStyle('a','color',this.value)"/></div>
      ` : ''}`;
  }
  else if (isDivider) {
    const hr = block.querySelector('hr');
    html += `
      <p class="pp-sec">Divisor</p>
      <div class="pp-row"><span class="pp-label">Color</span>
        <input type="color" class="pp-color" value="${hr?.style.borderTopColor ? rgbToHex(hr.style.borderTopColor) : '#e5e5e5'}"
          oninput="setPropTagStyle('hr','borderTopColor',this.value)"
          onchange="setPropTagStyle('hr','borderTopColor',this.value)"/></div>
      <div class="pp-row"><span class="pp-label">Grosor</span>
        <input type="text" class="pp-input" style="width:70px" value="${hr?.style.borderTopWidth || '2px'}"
          onchange="setPropTagStyle('hr','borderTopWidth',this.value)"/></div>
      <div class="pp-row"><span class="pp-label">Estilo</span>
        <select class="pp-select" onchange="setPropTagStyle('hr','borderTopStyle',this.value)">
          <option value="solid" ${hr?.style.borderTopStyle === 'solid' ? 'selected' : ''}>Sólido</option>
          <option value="dashed" ${hr?.style.borderTopStyle === 'dashed' ? 'selected' : ''}>Rayado</option>
          <option value="dotted" ${hr?.style.borderTopStyle === 'dotted' ? 'selected' : ''}>Punteado</option>
          <option value="double" ${hr?.style.borderTopStyle === 'double' ? 'selected' : ''}>Doble</option>
        </select></div>`;
  }
  
  if (!isDivider) {
    const contentEl = getEditableElement(block) || block;
    const currentPad = contentEl.style.padding || '';
    const currentMar = contentEl.style.marginBottom || contentEl.style.margin || '';

    html += `
      <p class="pp-sec">Espaciado</p>
      <div class="pp-row"><span class="pp-label">Padding</span>
        <input type="text" class="pp-input" style="width:70px" value="${escapeHtml(currentPad)}"
          oninput="setPropStyle('padding', this.value)"
          onchange="setPropStyle('padding', this.value)" placeholder="8px"/></div>
      <div class="pp-row"><span class="pp-label">Margen inferior</span>
        <input type="text" class="pp-input" style="width:70px" value="${escapeHtml(currentMar)}"
          oninput="setPropStyle('marginBottom', this.value)"
          onchange="setPropStyle('marginBottom', this.value)" placeholder="6px"/></div>`;
  }

  html += `
    <div style="margin-top:10px;display:flex;gap:6px">
      <button class="btn btn-ghost" style="flex:1;font-size:11px" onclick="duplicateBlock(selectedBlock?.querySelector('.bc-btn'))">Duplicar</button>
      <button class="btn" style="flex:1;font-size:11px;background:#611232;color:#e6d194;border:1px solid rgba(245,99,66,.25)" onclick="deleteBlock(selectedBlock?.querySelector('.bc-btn'))">Eliminar</button>
    </div>`;

  document.getElementById('pp-body').innerHTML = html;
}

/* ─ List block setters ─ */
function setListStyle(prop, val) {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector('ul, ol');
  if (el) {
    el.style[prop] = val;
    pushHistory();
  }
}
function setListStyleType(val) {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector('ul, ol');
  if (el) {
    el.style.listStyleType = val;
    pushHistory();
  }
}
function setListType(newTag) {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector('ul, ol');
  if (!el) return;
  const currentTag = el.tagName.toLowerCase();
  if (currentTag === newTag) return;
  const newEl = document.createElement(newTag);
  newEl.setAttribute('contenteditable', 'true');
  newEl.innerHTML = el.innerHTML;
  newEl.style.cssText = el.style.cssText;
  newEl.style.listStyleType = newTag === 'ol' ? 'decimal' : 'disc';
  el.parentNode.replaceChild(newEl, el);
  pushHistory();
  renderBlockProps(selectedBlock);
}
function addListItem() {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector('ul, ol');
  if (el) {
    const li = document.createElement('li');
    li.textContent = 'Elemento de lista';
    el.appendChild(li);
    pushHistory();
  }
}
function removeListItem() {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector('ul, ol');
  if (el && el.children.length > 1) {
    el.lastElementChild.remove();
    pushHistory();
  } else {
    toast('err', 'La lista necesita al menos un elemento');
  }
}

function setFileAlign(align) {
  if (!selectedBlock) return;
  const wrap = selectedBlock.querySelector('.b-file');
  if (wrap) {
    wrap.style.justifyContent = align;
    pushHistory();
    renderBlockProps(selectedBlock);
  }
}

function toggleFileStyle(prop, onValue, offValue) {
  if (!selectedBlock) return;
  const link = selectedBlock.querySelector('a');
  if (link) {
    const currentValue = link.style[prop];
    if (prop === 'fontWeight') {
      link.style.fontWeight = (currentValue === 'bold' || currentValue === '700') ? 'normal' : 'bold';
    } else if (prop === 'fontStyle') {
      link.style.fontStyle = currentValue === 'italic' ? 'normal' : 'italic';
    } else {
      link.style[prop] = currentValue === onValue ? offValue : onValue;
    }
    pushHistory();
    renderBlockProps(selectedBlock);
  }
}

function setFileUnderline(active) {
  if (!selectedBlock) return;
  const link = selectedBlock.querySelector('a');
  if (link) {
    link.style.textDecoration = active ? 'underline' : 'none';
    pushHistory();
    renderBlockProps(selectedBlock);
  }
}

function toggleFileUnderline() {
  if (!selectedBlock) return;
  const link = selectedBlock.querySelector('a');
  if (link) {
    const current = link.style.textDecoration;
    link.style.textDecoration = current === 'underline' ? 'none' : 'underline';
    pushHistory();
    renderBlockProps(selectedBlock);
  }
}

function escapeHtml(str) {
  if (!str) return '';
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderSectionProps(sec) {
  const html = `
    <p class="pp-sec">Sección</p>
    <div class="pp-row"><span class="pp-label">Fondo</span>
      <input type="color" class="pp-color" value="${sec.dataset.bg||'#ffffff'}"
        oninput="sec.style.backgroundColor=this.value;sec.dataset.bg=this.value"
        onchange="sec.style.backgroundColor=this.value;sec.dataset.bg=this.value"/></div>
    <div class="pp-row"><span class="pp-label">Padding Y</span>
      <input type="text" class="pp-input" style="width:70px" value="${sec.style.paddingTop||'16px'}"
        onchange="sec.style.paddingTop=this.value;sec.style.paddingBottom=this.value"/></div>
    <div class="pp-row"><span class="pp-label">Padding X</span>
      <input type="text" class="pp-input" style="width:70px" value="${sec.style.paddingLeft||'0px'}"
        onchange="sec.style.paddingLeft=this.value;sec.style.paddingRight=this.value"/></div>
    <p class="pp-sec">Columnas</p>
    <p style="font-size:11px;color:var(--txt2);margin-bottom:8px">Agrega o ajusta las columnas de esta sección.</p>
    <button class="btn btn-ghost" style="width:100%;font-size:11px;margin-bottom:6px" onclick="addColToSection(selectedSection)">+ Agregar columna</button>
    <button class="btn btn-ghost" style="width:100%;font-size:11px" onclick="removeColFromSection(selectedSection)">− Quitar columna</button>
    <p class="pp-sec">Acciones</p>
    <div style="display:flex;gap:6px">
      <button class="btn btn-ghost" style="flex:1;font-size:11px" onclick="moveSectionUp(selectedSection?.querySelector('.sc-btn'))">↑ Subir</button>
      <button class="btn btn-ghost" style="flex:1;font-size:11px" onclick="moveSectionDown(selectedSection?.querySelectorAll('.sc-btn')[1])">↓ Bajar</button>
    </div>
    <button class="btn" style="width:100%;margin-top:6px;font-size:11px;background:rgba(245,99,66,.12);color:var(--rose);border:1px solid rgba(245,99,66,.25)"
      onclick="deleteSection(selectedSection?.querySelector('.sc-btn'))">Eliminar sección</button>`;
  document.getElementById('pp-body').innerHTML = html;
}

function getEditableElement(block) {
  if (!block) return null;
  return block.querySelector('.b-heading1, .b-heading2, .b-heading3, .b-paragraph, .b-quote, .b-list, .b-link, .b-button-wrap, .b-file, .b-image-wrap, [contenteditable]');
}

function setPropStyle(prop, val) {
  if (!selectedBlock) return;
  const el = getEditableElement(selectedBlock) || selectedBlock;
  if (el) { 
    el.style[prop] = val;
    
    // Si la propiedad afecta texto o dimensiones, limpia hijos para permitir cascada CSS pura
    if (['fontSize', 'fontFamily', 'color', 'backgroundColor'].includes(prop)) {
      el.querySelectorAll('*').forEach(child => {
        if (child.style) child.style[prop] = '';
      });
    }
    
    pushHistory();
  }
}

function togglePropStyle(prop, onValue, offValue) {
  if (!selectedBlock) return;
  const el = getEditableElement(selectedBlock);
  if (el) { 
    const currentValue = el.style[prop];
    
    if (prop === 'fontWeight') {
      if (currentValue === 'bold' || currentValue === '700' || currentValue === 'bolder') {
        el.style.fontWeight = 'normal';
      } else {
        el.style.fontWeight = 'bold';
      }
    } else if (prop === 'fontStyle') {
      el.style.fontStyle = currentValue === 'italic' ? 'normal' : 'italic';
    } else if (prop === 'textDecoration') {
      el.style.textDecoration = currentValue === 'underline' ? 'none' : 'underline';
    } else {
      el.style[prop] = currentValue === onValue ? offValue : onValue;
    }
    
    pushHistory();
    renderBlockProps(selectedBlock);
  }
}

function setPropAttr(tag, attr, val) {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector(tag);
  if (el) { el[attr] = val; pushHistory(); }
}
function setPropTagStyle(tag, prop, val) {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector(tag);
  if (el) {
    if (val && val !== '') {
      el.style[prop] = val;
    } else {
      el.style[prop] = '';
    }
    pushHistory();
  }
}
function setPropTextContent(tag, val) {
  if (!selectedBlock) return;
  const el = selectedBlock.querySelector(tag);
  if (el) {
    el.textContent = val;
    pushHistory();
  }
}

function setImageSrc(src) {
  if (!selectedBlock) return;
  let img = selectedBlock.querySelector('img');
  
  if (!img) {
    const placeholder = selectedBlock.querySelector('.b-image-placeholder');
    if (placeholder) {
      placeholder.outerHTML = `<div class="b-image-wrap" style="justify-content: flex-start"><img src="${src}" style="max-width:100%;height:auto;display:block"/></div>`;
    }
  } else {
    img.src = src;
  }
  pushHistory();
  renderBlockProps(selectedBlock);
}

function setImageAlt(alt) {
  if (!selectedBlock) return;
  const img = selectedBlock.querySelector('img');
  if (img) {
    img.alt = alt;
    pushHistory();
  }
}

function setImageAlign(align) {
  if (!selectedBlock) return;
  const wrap = selectedBlock.querySelector('.b-image-wrap');
  if (wrap) {
    wrap.style.justifyContent = align;
    pushHistory();
    renderBlockProps(selectedBlock);
  }
}

function setImageStyle(prop, val) {
  if (!selectedBlock) return;
  const img = selectedBlock.querySelector('img');
  if (img) {
    if (val && val !== 'auto') {
      img.style[prop] = val;
    } else {
      img.style[prop] = '';
    }
    pushHistory();
  }
}

function uploadImage(input) {
  if (!selectedBlock) {
    toast('err', 'Selecciona un bloque de imagen primero');
    return;
  }
  
  if (input.files && input.files[0]) {
    const file = input.files[0];
    if (!file.type.startsWith('image/')) {
      toast('err', 'Por favor selecciona un archivo de imagen válido');
      input.value = '';
      return;
    }
    
    const reader = new FileReader();
    reader.onload = function(e) {
      setImageSrc(e.target.result);
      toast('ok', 'Imagen cargada correctamente');
      input.value = '';
    };
    reader.onerror = function() {
      toast('err', 'Error al cargar la imagen');
      input.value = '';
    };
    reader.readAsDataURL(file);
  }
}

function uploadFile(input) {
  if (!selectedBlock) {
    toast('err', 'Selecciona un bloque de archivo primero');
    return;
  }
  
  if (input.files && input.files[0]) {
    const file = input.files[0];
    const reader = new FileReader();
    
    reader.onload = function(e) {
      const dataUrl = e.target.result;
      const link = selectedBlock.querySelector('a');
      if (link) {
        link.href = dataUrl;
        link.setAttribute('data-filename', file.name);
        link.setAttribute('download', file.name);

        if (!link.textContent.trim() || link.textContent === 'Descargar archivo') {
          link.textContent = "Descargar archivo";
        }
        
        pushHistory();
        renderBlockProps(selectedBlock);
        toast('ok', `Archivo "${file.name}" cargado correctamente`);
      }
      input.value = '';
    };
    
    reader.onerror = function() {
      toast('err', 'Error al cargar el archivo');
      input.value = '';
    };
    
    reader.readAsDataURL(file);
  }
}

/* ═══════════════════════════════════════════════════
   BLOCK OPERATIONS
═══════════════════════════════════════════════════ */
function deleteBlock(btn) {
  const block = btn?.closest?.('.block') || selectedBlock;
  if (!block) return;
  if (selectedBlock === block) { 
    selectedBlock = null; 
    document.getElementById('pp-body').innerHTML = '<div class="pp-empty"><div class="pp-empty-ico">◎</div>Selecciona un elemento</div>'; 
  }
  block.remove();
  pushHistory();
}

function duplicateBlock(btn) {
  const block = btn?.closest('.block') || selectedBlock;
  if (!block) return;
  const clone = block.cloneNode(true);
  clone.id = 'blk-' + (++blockCounter);
  block.parentNode.insertBefore(clone, block.nextSibling);
  rebindCanvas();
  selectBlock(clone);
  pushHistory();
}

function moveBlockUp(btn) {
  const block = btn.closest('.block');
  const prev = block.previousElementSibling;
  if (prev && prev.classList.contains('block')) { block.parentNode.insertBefore(block, prev); pushHistory(); }
}
function moveBlockDown(btn) {
  const block = btn.closest('.block');
  const next = block.nextElementSibling;
  if (next && next.classList.contains('block')) { block.parentNode.insertBefore(next, block); pushHistory(); }
}

/* ═══════════════════════════════════════════════════
   SECTION OPERATIONS
═══════════════════════════════════════════════════ */
function deleteSection(btn) {
  const sec = btn?.closest?.('.section') || selectedSection;
  if (!sec) return;
  if (document.querySelectorAll('.section').length <= 1) { toast('err', 'Debe haber al menos una sección'); return; }
  sec.remove();
  selectedSection = null;
  document.getElementById('pp-body').innerHTML = '<div class="pp-empty"><div class="pp-empty-ico">◎</div>Selecciona un elemento</div>';
  pushHistory();
}
function moveSectionUp(btn) {
  const sec  = btn?.closest?.('.section') || selectedSection;
  const prev = sec?.previousElementSibling;
  if (sec && prev && prev.classList.contains('section')) { sec.parentNode.insertBefore(sec, prev); pushHistory(); }
}
function moveSectionDown(btn) {
  const sec  = btn?.closest?.('.section') || selectedSection;
  const next = sec?.nextElementSibling;
  if (sec && next && next.classList.contains('section')) { sec.parentNode.insertBefore(next, sec); pushHistory(); }
}
function addColToSection(sec) {
  if (!sec) return;
  const colsWrap = sec.querySelector('.section-cols');
  const idx = colsWrap.children.length;
  const col = buildCol(sec.dataset.secid, idx, 1);
  colsWrap.appendChild(col);
  pushHistory();
}
function removeColFromSection(sec) {
  if (!sec) return;
  const colsWrap = sec.querySelector('.section-cols');
  if (colsWrap.children.length > 1) { colsWrap.lastElementChild.remove(); pushHistory(); }
  else toast('err', 'La sección necesita al menos 1 columna');
}
function openSectionProps(btn) {
  const sec = btn.closest('.section');
  selectSection(sec);
}

/* ═══════════════════════════════════════════════════
   HISTORY (Undo/Redo)
═══════════════════════════════════════════════════ */
function pushHistory() {
  if (undoing) return;
  const snap = document.getElementById('page-canvas').innerHTML;
  history = history.slice(0, historyIdx + 1);
  history.push(snap);
  if (history.length > 60) history.shift();
  historyIdx = history.length - 1;
}
function histUndo() {
  if (historyIdx <= 0) return;
  undoing = true;
  historyIdx--;
  document.getElementById('page-canvas').innerHTML = history[historyIdx];
  rebindCanvas();
  undoing = false;
}
function histRedo() {
  if (historyIdx >= history.length - 1) return;
  undoing = true;
  historyIdx++;
  document.getElementById('page-canvas').innerHTML = history[historyIdx];
  rebindCanvas();
  undoing = false;
}
function rebindCanvas() {
  document.querySelectorAll('.col').forEach(col => {
    col.addEventListener('dragover', e => { e.preventDefault(); col.classList.add('drag-over'); });
    col.addEventListener('dragleave', () => col.classList.remove('drag-over'));
    col.addEventListener('drop', e => {
      e.preventDefault(); col.classList.remove('drag-over');
      const type = e.dataTransfer.getData('block-type');
      const srcId = e.dataTransfer.getData('block-id');
      if (type) { const b = createBlock(type); col.appendChild(b); selectBlock(b); pushHistory(); }
      else if (srcId) { const ex = document.getElementById(srcId); if (ex) { col.appendChild(ex); pushHistory(); } }
    });
  });
  document.querySelectorAll('.block').forEach(block => {
    block.addEventListener('click', e => { e.stopPropagation(); selectBlock(block); });
    block.addEventListener('dragstart', e => { e.dataTransfer.setData('block-id', block.id); e.stopPropagation(); setTimeout(()=>block.style.opacity='.4',0); });
    block.addEventListener('dragend', () => block.style.opacity='1');
  });
  document.querySelectorAll('.section').forEach(sec => {
    sec.addEventListener('click', e => { if(!e.target.closest('.block')&&!e.target.closest('.sc-btn')) selectSection(sec); });
  });
}

document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'z' && !e.shiftKey) { e.preventDefault(); histUndo(); }
  if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.key === 'z' && e.shiftKey))) { e.preventDefault(); histRedo(); }
  if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); savePage(); }
});

/* ═══════════════════════════════════════════════════
   PREVIEW MODE
═══════════════════════════════════════════════════ */
function setMode(mode) {
  document.body.classList.toggle('preview-mode', mode === 'preview');
  document.getElementById('btn-edit-mode').classList.toggle('active', mode === 'edit');
  document.getElementById('btn-preview-mode').classList.toggle('active', mode === 'preview');
}

/* ═══════════════════════════════════════════════════
   SERIALIZE
═══════════════════════════════════════════════════ */
function serializeToHTML() {
  const sections = document.querySelectorAll('#page-canvas .section');
  let bodyHTML = '';

  sections.forEach(sec => {
    const bg   = sec.dataset.bg || '#98989a';
    const padT = sec.style.paddingTop    || '32px';
    const padB = sec.style.paddingBottom || '32px';
    const padL = sec.style.paddingLeft   || '0px';
    const padR = sec.style.paddingRight  || '0px';

    bodyHTML += `<section data-pad-t="${padT}" data-pad-b="${padB}" data-pad-l="${padL}" data-pad-r="${padR}" style="background:${bg};padding:${padT} 0 ${padB} 0;width:100%;box-sizing:border-box;">\n`;
    bodyHTML += `  <div class="content-wrap" style="max-width:1200px;margin:0 auto;padding-left:calc(${padL} + 20px);padding-right:calc(${padR} + 20px);display:flex;flex-wrap:wrap;width:100%;">\n`;

    sec.querySelectorAll('.col').forEach(col => {
      const flex = col.style.flex || '1';
      bodyHTML += `  <div style="flex:${flex};padding:8px 12px;min-width:0;box-sizing:border-box;">\n`;

      col.querySelectorAll('.block').forEach(block => {
        const clone = block.cloneNode(true);
        clone.querySelectorAll('.block-ctrl,.block-handle').forEach(el => el.remove());
        clone.querySelectorAll('[contenteditable]').forEach(el => {
          el.removeAttribute('contenteditable');
          el.removeAttribute('data-placeholder');
        });
        bodyHTML += '    ' + clone.innerHTML.trim() + '\n';
      });

      bodyHTML += '  </div>\n';
    });
    bodyHTML += '  </div>\n';
    bodyHTML += '</section>\n';
  });

  const pageCSS = `
  section{width:100%}
  h1,h2,h3{line-height:1.2}
  img{max-width:100%;height:auto;display:block}
  ul,ol{padding-left:1.5em}
  blockquote{border-left:4px solid #1a1a1a;padding:8px 16px;background:#f9f9f9;font-style:italic;color:#555}
  .b-heading1{font-family:Georgia,serif;font-size:2.2em;font-weight:700;line-height:1.2;color:#1a1a1a}
  .b-heading2{font-family:Georgia,serif;font-size:1.6em;font-weight:700;line-height:1.3}
  .b-heading3{font-family:Georgia,serif;font-size:1.25em;font-weight:700;line-height:1.4}
  .b-paragraph{font-size:1em;line-height:1.7;color:#333}
  .b-list ul,.b-list ol{padding-left:1.4em;line-height:1.8;list-style-position:outside}
  .b-list ul{list-style-type:disc}
  .b-list ol{list-style-type:decimal}
  .b-link a{color:#1a6cf0;text-decoration:underline}
  .b-divider hr{border:none;border-top:2px solid #e5e5e5;margin:8px 0}
  .b-button-wrap{display:flex}
  .b-image-wrap{display:flex}
  .b-btn{display:inline-block;padding:10px 24px;background:#1a1a1a;color:#fff;border-radius:6px;text-decoration:none;font-weight:600;font-size:.95em}
  .b-quote{border-left:4px solid #1a1a1a;padding:8px 16px;background:#f9f9f9;font-style:italic;color:#555}
  .b-file a{color:#1a6cf0;text-decoration:underline;cursor:pointer}`;

  return `
  ${bodyHTML}
  <style>${pageCSS}</style>
`;
}

/* ═══════════════════════════════════════════════════
   LOAD FROM HTML
═══════════════════════════════════════════════════ */
function loadFromHTML(htmlStr) {
  const canvas = document.getElementById('page-canvas');
  canvas.innerHTML = '';
  secCounter = 0; blockCounter = 0;

  const parser = new DOMParser();
  const doc = parser.parseFromString(htmlStr, 'text/html');
  const savedSecs = doc.querySelectorAll('section');

  if (savedSecs.length === 0) {
    addSectionToCanvas(1, null, '#98989a');
    return;
  }

  savedSecs.forEach(savedSec => {
    const bg = savedSec.style.background || '#ffffff';
    
    let cols = savedSec.querySelectorAll(':scope > .content-wrap > div');
    if (cols.length === 0) cols = savedSec.querySelectorAll(':scope > div');

    const flexArr = Array.from(cols).map(c => c.style.flex || '1');

    const sec = addSectionToCanvas(cols.length, flexArr.join(','), bg);

    let pT = savedSec.dataset.padT;
    let pB = savedSec.dataset.padB;
    let pL = savedSec.dataset.padL;
    let pR = savedSec.dataset.padR;

    if (!pT) {
      const styleStr = savedSec.getAttribute('style') || '';
      const padMatch = styleStr.match(/padding:\s*([^ ]+)\s+calc\(([^)]+)\s*\+\s*20px\)\s+([^ ]+)\s+calc\(([^)]+)\s*\+\s*20px\)/);
      if (padMatch) {
        pT = padMatch[1]; pL = padMatch[2]; pB = padMatch[3]; pR = padMatch[4];
      } else {
        pT = savedSec.style.paddingTop || '16px';
        pB = savedSec.style.paddingBottom || '16px';
        pL = savedSec.style.paddingLeft || '0px';
        pR = savedSec.style.paddingRight || '0px';
        if (pL.includes('calc')) pL = pL.replace(/calc\(([^)]+)\s*\+\s*20px\)/, '$1').trim();
        if (pR.includes('calc')) pR = pR.replace(/calc\(([^)]+)\s*\+\s*20px\)/, '$1').trim();
      }
    }

    sec.style.paddingTop = pT; sec.style.paddingBottom = pB;
    sec.style.paddingLeft = pL; sec.style.paddingRight = pR;
    sec.dataset.padT = pT; sec.dataset.padB = pB; sec.dataset.padL = pL; sec.dataset.padR = pR;

    const domCols = sec.querySelectorAll('.col');
    cols.forEach((savedCol, ci) => {
      const domCol = domCols[ci];
      if (!domCol) return;
 
      Array.from(savedCol.children).forEach(child => {
        const type = detectBlockType(child);
        const data = extractBlockData(child, type);
        
        if (type === 'image' && data.src && !data.src.match(/^(http|\/|data:)/)) {
          data.src = `/imagenes/${DIR_PATH}/${data.src}`;
        }
        if (type === 'file' && data.href && !data.href.match(/^(http|#|\/|data:)/)) {
          data.href = `/imagenes/${DIR_PATH}/${data.href}`;
        }

        const block = createBlock(type, data);
        domCol.appendChild(block);
      });
    });
  });
}

function extractBlockData(el, type) {
  const data = {};
  const contentEl =
    el.querySelector('.b-heading1') ||
    el.querySelector('.b-heading2') ||
    el.querySelector('.b-heading3') ||
    el.querySelector('.b-paragraph') ||
    el.querySelector('.b-quote') ||
    el;
  const styleAttr = contentEl.getAttribute('style') || '';

  switch (type) {
    case 'heading1':
    case 'heading2':
    case 'heading3':
    case 'paragraph':
      data.text = contentEl.innerHTML || '';
      data.style = styleAttr;
      break;
    case 'quote':
      data.text = contentEl.innerHTML || '';
      data.style = styleAttr;
      break;
    case 'list': {
      const list = el.querySelector('ul, ol') || el;
      data.listHTML = list.innerHTML || '<li>Elemento de lista</li>';
      data.style = el.getAttribute('style') || '';
      data.listType = list.tagName ? list.tagName.toLowerCase() : 'ul';
      data.listStyleType = list.style ? list.style.listStyleType : '';
      break;
    }
    case 'link': {
      const a = el.querySelector('a') || el;
      data.text = a.textContent || '';
      data.href = a.getAttribute('href') || '#';
      data.style = styleAttr;
      break;
    }
    case 'button': {
      const btn = el.querySelector('.b-btn') || el.querySelector('a') || el;
      data.text = btn.textContent || 'Botón';
      data.href = btn.getAttribute('href') || '#';
      data.style = styleAttr;
      const wrap = el.classList.contains('b-button-wrap') ? el : el.querySelector('.b-button-wrap');
      data.align = (wrap && wrap.style.justifyContent) || 'flex-start';
      break;
    }
    case 'file': {
      const link = el.querySelector('a') || el;
      const wrap = el.querySelector('.b-file') || el;
      data.href = link.getAttribute('href') || '#';
      data.text = link.textContent || 'Descargar archivo';
      data.download = link.hasAttribute('download');
      data.target = link.getAttribute('target') || null;
      data.linkStyle = link.getAttribute('style') || '';
      data.align = wrap.style.justifyContent || 'flex-start';
      data.style = wrap.getAttribute('style') || '';
      break;
    }
    case 'image': {
      const img = el.querySelector('img') || el;
      const wrap = el.querySelector('.b-image-wrap') || el;
      data.src = img.getAttribute('src') || '';
      data.alt = img.getAttribute('alt') || '';
      data.style = img.getAttribute('style') || '';
      data.align = (wrap && wrap.style.justifyContent) || 'flex-start';
      break;
    }
    default:
      break;
  }

  return data;
}

function detectBlockType(el) {
  const tag = el.tagName?.toLowerCase();
  const cls = el.className || '';
  if (cls.includes('b-heading1') || tag === 'h1') return 'heading1';
  if (cls.includes('b-heading2') || tag === 'h2') return 'heading2';
  if (cls.includes('b-heading3') || tag === 'h3') return 'heading3';
  if (cls.includes('b-paragraph') || tag === 'p') return 'paragraph';
  if (cls.includes('b-quote') || tag === 'blockquote') return 'quote';
  if (cls.includes('b-list') || tag === 'ul' || tag === 'ol') return 'list';
  if (cls.includes('b-link')) return 'link';
  if (cls.includes('b-file')) return 'file';
  if (cls.includes('b-button-wrap')) return 'button';
  if (cls.includes('b-divider') || tag === 'hr') return 'divider';
  if (cls.includes('b-image') || tag === 'img') return 'image';
  return 'paragraph';
}

/* ═══════════════════════════════════════════════════
   SAVE
═══════════════════════════════════════════════════ */
async function savePage() {
    const content = serializeToHTML();
    const btn = document.querySelector('.btn-amber[onclick="savePage()"]');

    if (btn) {
        btn.textContent = 'Guardando...';
        btn.disabled = true;
        const spinner = document.getElementById('spinner');
        if (spinner) spinner.classList.remove('hidden');
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 120000);

    try {
        const res = await fetch(`/storages/${STORAGE_ID}/page`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                dirPath: DIR_PATH,
                filename: FILENAME,
                content
            }),
            signal: controller.signal
        });

        clearTimeout(timeoutId);

        const data = await res.json();
        if (!res.ok) throw new Error(data.message || data.error || 'Error al guardar');

        const correctDirPath  = data.data.dirPath;
        const correctFilename = data.data.filename;

        const pagina = await fetch('/paginas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                ruta_pag: correctDirPath.replace(/\\/g, '/') ,
                nombre_pag: correctFilename,
                descripcion_pag: '',
                fk_id_storage: STORAGE_ID
            })
        });

        const dataPagina = await pagina.json();
        if (!pagina.ok) throw new Error(dataPagina.error || 'Error al registrar página');
        
        Swal.fire({
            title: 'Página guardada con éxito',
            icon: 'success',
            confirmButtonText: 'OK'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href =
                    `/editor?storageId=${STORAGE_ID}` +
                    `&dirPath=${correctDirPath.replace(/\\/g, '/')}` +
                    `&filename=${correctFilename}`;
            }
        });

    } catch (err) {
        console.error('ERROR savePage:', err);
        clearTimeout(timeoutId);

        if (err.name === 'AbortError') {
            toast('err', 'El servidor no respondió a tiempo. Intenta de nuevo.');
        } else {
            toast('err', err.message);
        }

    } finally {
        clearTimeout(timeoutId);
        if (btn) {
            btn.textContent = '💾 Guardar';
            btn.disabled = false;
            const spinner = document.getElementById('spinner');
            if (spinner) spinner.classList.add('hidden');
        }
    }
}

/* ═══════════════════════════════════════════════════
   HELPERS
═══════════════════════════════════════════════════ */
function typeLabel(t) {
  return { heading1:'Título H1', heading2:'Título H2', heading3:'Título H3',
    paragraph:'Párrafo', quote:'Cita', list:'Lista', link:'Enlace',
    button:'Botón', divider:'Divisor', image:'Imagen', file:'Archivo' }[t] || t;
}

function rgbToHex(rgb) {
  if (!rgb) return '#000000';
  if (rgb.startsWith('#')) return rgb;
  if (rgb === 'transparent') return '#ffffff';

  const rgbaMatch = rgb.match(/rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)\s*(?:,\s*([\d.]+)\s*)?\)/);
  if (rgbaMatch) {
    const alpha = rgbaMatch[4] !== undefined ? parseFloat(rgbaMatch[4]) : 1;
    if (alpha === 0) return '#ffffff';
    const hex = [rgbaMatch[1], rgbaMatch[2], rgbaMatch[3]].map(n => {
      const hexVal = parseInt(n).toString(16);
      return hexVal.length === 1 ? '0' + hexVal : hexVal;
    }).join('');
    return '#' + hex;
  }

  return '#000000';
}

function toast(type, msg) {
  const zone = document.getElementById('toasts');
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `<span>${msg}</span><button style="margin-left:auto;background:none;border:none;color:var(--txt2);cursor:pointer" onclick="this.parentElement.remove()">×</button>`;
  zone.appendChild(el);
  setTimeout(() => { el.style.animation='tOut .3s ease forwards'; setTimeout(()=>el.remove(),350); }, 4000);
}
