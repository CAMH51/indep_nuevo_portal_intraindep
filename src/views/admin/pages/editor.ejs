            <button class="pp-btn ${textAlign === 'center' ? 'on' : ''}" onclick="setPropStyle('textAlign','center'); renderBlockProps(selectedBlock);"><i class="bi bi-text-center"></i></button>
            <button class="pp-btn ${textAlign === 'right' ? 'on' : ''}" onclick="setPropStyle('textAlign','right'); renderBlockProps(selectedBlock);"><i class="bi bi-text-right"></i></button>
            <button class="pp-btn ${textAlign === 'justify' ? 'on' : ''}" onclick="setPropStyle('textAlign','justify'); renderBlockProps(selectedBlock);"><i class="bi bi-justify"></i></button>
          </div></div>
        <p class="pp-sec">Color</p>
