    const align = wrap ? wrap.style.justifyContent : 'flex-start';
    
    html += `
      <p class="pp-sec">Imagen</p>
      <div class="pp-row"><span class="pp-label">Subir archivo</span></div>
      <input type="file" class="pp-input" style="margin-bottom:12px" accept="image/*" onchange="uploadImage(this)"/>
      
