          <input type="color" class="pp-color" value="${rgbToHex(bgColor)}"
            oninput="setPropStyle('backgroundColor', this.value)"
            onchange="setPropStyle('backgroundColor', this.value)"/></div>`;
    }
  }
  else if (isList) {
    const listEl = block.querySelector('ul, ol');
    if (!listEl) {
      html += `<div class="pp-empty">Bloque de lista sin editor</div>`;
