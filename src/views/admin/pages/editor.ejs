<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>PageVault · Editor — <%= typeof filename !== 'undefined' ? filename : 'nueva-pagina' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@300;400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
  <style>
  /* ═══════════════════════════════════════════════════════
     TOKENS
  ═══════════════════════════════════════════════════════ */
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  
  :root{
    --bg:#fff; --bg2:#a57f2c; --bg3:#a57f2c; --bg4:#222228; --line:#f6f6f7;
    --amber:#a57f2c; --teal:#42c8c8; --rose:#f56342; --violet:#a78bfa;
    --green:#6ee7b7; --txt:#e8e6e0; --txt2:#000; --txt3:#fff;
    --fh:'Noto Sans Regular';
    --fb:'Noto Sans Regular';
    --fm:'Noto Sans Regular';
    --r:10px;
  }
  /* ═══════════════════════════════════════════════════════
     TOP TOOLBAR
  ═══════════════════════════════════════════════════════ */
  .toolbar{
    height:48px; background:#9b2247; border-bottom:1px solid var(--line);
    display:flex; align-items:center; padding:5px 16px; gap:8px; flex-shrink:0; z-index:100;
  }
  .tb-brand{font-family:var(--fh);font-size:17px;color:var(--txt);margin-right:4px;white-space:nowrap}
  .tb-brand em{color:var(--amber);font-style:italic}
  .tb-sep{width:1px;height:22px;background:#a57f2c;margin:0 4px}
  .tb-file{font-family:var(--fm);font-size:15px;color:#98989a;font-weight: bold;}
  .tb-file span{color:#e6d194
    ;font-weight: bold;font-size: 15px;}

  .tb-group{display:flex;align-items:center;gap:4px}
  .tb-group-label{font-family:var(--fm);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--txt3);padding:0 6px}

  .btn{display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:7px;font-family:var(--fb);font-size:12px;font-weight:600;cursor:pointer;border:none;text-decoration:none;transition:all .15s;line-height:1;white-space:nowrap}
  .btn-amber{background: #989898;;color:#0d0d0e}
  .btn-amber:hover{filter:brightness(1.1)}
  .btn-ghost{background:transparent;color: #e6e6e6;;border:1px solid var(--line)}
  .btn-ghost:hover{background:var(--bg3);color:var(--txt)}
  .btn-active{background:rgba(245,166,35,.15);color:var(--amber);border:1px solid rgba(245,166,35,.3)}
  .btn-ico{padding:6px 8px}
  .tb-spacer{flex:1}

  .preview-toggle{display:flex;background:var(--bg3);border:1px solid var(--line);border-radius:7px;overflow:hidden}
  .preview-toggle button{padding:5px 12px;background:none;border:none;color:var(--txt3);font-size:11px;cursor:pointer;font-family:var(--fb);font-weight:600;transition:all .15s}
  .preview-toggle button.active{background:var(--bg4);color:var(--amber)}

  /* ═══════════════════════════════════════════════════════
     MAIN EDITOR AREA
  ═══════════════════════════════════════════════════════ */
  .editor-shell{display:flex;flex:1;overflow:hidden}

  /* LEFT PANEL — Component palette */
  .palette{
    width:200px; background:#a57f2c; border:2px solid #a57f2c;
    display:flex; flex-direction:column; overflow:hidden; flex-shrink:0;
  }
  .palette-head{padding:11px 14px;border-bottom:2px solid #e6d194;font-family:var(--fm);font-size:14px;letter-spacing:2.5px;text-transform:uppercase;color:#fff; font-weight: bold; text-align: center;}
  .palette-body{flex:1;overflow-y:auto;padding:10px}
  .palette-sec{font-family:var(--fm);font-size:14px;letter-spacing:2px;text-transform:uppercase;color:#fff;padding:8px 4px 5px;font-weight: bold;}

  .comp-item{
    display:flex;align-items:center;gap:9px;padding:8px 10px;
    border-bottom:1px solid #e6d194;background:transparent;
    margin-bottom:6px;cursor:grab;font-size:12.5px;font-weight:500;color:var(--txt2);
    transition:border-color .15s,color .15s,transform .15s;user-select:none;
  }
  .comp-item:hover{border-color:rgba(245,166,35,.3);color:#9b2247;transform:translateX(2px);background: #e6d194;}
  .comp-item:active{cursor:grabbing}
  .comp-ico{font-size:15px;width:20px;text-align:center;flex-shrink:0}

  /* CENTER — Canvas */
  .canvas-wrap{
    flex:1;overflow-y:auto;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(97,18,50,.08) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(30,91,79,.08) 0%, transparent 50%),
      #f4f1ec;
    padding:28px;display:flex;flex-direction:column;align-items:center;gap:0;
  }
  .canvas-wrap::-webkit-scrollbar{width:5px}
  .canvas-wrap::-webkit-scrollbar-thumb{background:var(--line);border-radius:10px}

  .page-canvas{
    width:100%;max-width:920px;height:calc(100vh - 200px);
    display:flex;flex-direction:column;gap:0;
    background:#fff;
    box-shadow:0 0 0 1px rgba(0,0,0,.08),0 4px 40px rgba(0,0,0,.12),0 24px 80px rgba(0,0,0,.06);
    border-radius:4px;
    overflow:scroll;
  }

  /* RIGHT PANEL — Properties */
  .props-panel{
    width:220px;background:#a57f2c;border:2px solid #a57f2c;;
    display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;
  }
  .pp-head{padding:11px 14px;border-bottom:1px solid #e6d194;display:flex;align-items:center;justify-content:space-between}
  .pp-title{font-family:var(--fm);font-size:14px;letter-spacing:2.5px;text-transform:uppercase;color:#fff;font-weight: bold;text-align: center}
  .pp-body{flex:1;overflow-y:auto;padding:12px}
  .pp-body::-webkit-scrollbar{width:4px}
  .pp-body::-webkit-scrollbar-thumb{background:var(--line);border-radius:10px}

  .pp-sec{font-family:var(--fm);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--txt3);margin:10px 0 6px;padding-top:10px;border-top:1px solid var(--line)}
  .pp-sec:first-child{margin-top:0;padding-top:0;border-top:none}
  .pp-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px}
  .pp-label{font-size:11px;color:var(--txt2);flex-shrink:0}
  .pp-input{
    width:100%;background:#fff;border:1px solid #e6d194;color: #9b2247;;
    padding:5px 8px;border-radius:6px;font-family:var(--fb);font-size:11.5px;outline:none;
    transition:border-color .15s;
  }
  .pp-input:focus{border-color:#e6d194}
  .pp-input.mono{font-family:var(--fm);font-size:11px}
  .pp-color{width:36px;height:28px;padding:2px;background:var(--bg3);border:1px solid var(--line);border-radius:6px;cursor:pointer}
  .pp-select{width:100%;border:1px solid var(--line);color: #9b2247;padding:5px 8px;border-radius:6px;font-size:11.5px;outline:none;cursor:pointer}
  .pp-select option{background: #e6d194;}
  .pp-btns{display:flex;gap:4px;margin-top:4px}
  .pp-btn{
    padding:5px 10px;
    background:transparent;
    border:1px solid var(--line);
    color:#fff;
    border-radius:6px;
    font-size:12px;
    cursor:pointer;
    transition:all .12s;
    text-align:center;
  }
  .pp-btn:hover{background: #e6e6e6;color: #9b9b9b;}
  .pp-btn.on{
    background:#9b2247;
    color:#fff;
    border-color:rgba(245,166,35,.3);
  }

  .pp-empty{text-align:center;padding:30px 10px;color:var(--txt3);font-size:12px}
  .pp-empty-ico{font-size:28px;margin-bottom:8px}

  /* ═══════════════════════════════════════════════════════
     SECTIONS
  ═══════════════════════════════════════════════════════ */
  .section{
    width:100%;position:relative;background:#fff;
    border:2px solid transparent;transition:border-color .15s;
    margin-bottom:0;
  }
  .section:hover>.section-ctrl{opacity:1}
  .section.selected{border-color:rgba(245,166,35,.5)!important}
  .section-ctrl{
    position:absolute;top:-1px;right:-1px;z-index:20;
    display:flex;gap:3px;background:var(--bg2);border:1px solid var(--line);
    border-radius:0 0 0 8px;padding:3px 5px;opacity:0;transition:opacity .15s;
  }
  .sc-btn{width:22px;height:22px;background:none;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:var(--txt2);display:grid;place-items:center;transition:all .10s}
  .sc-btn:hover{background:var(--bg3);color:var(--txt)}
  .sc-btn.red:hover{background:rgba(245,99,66,.2);color:var(--rose)}

  .section-cols{display:flex;width:100%;min-height:80px}

  /* ═══════════════════════════════════════════════════════
     COLUMNS
  ═══════════════════════════════════════════════════════ */
  .col{
    flex:1;padding:12px;min-height:80px;position:relative;
    border:2px dashed transparent;transition:border-color .15s,background .15s;
  }
  .col+.col{border-left:1px solid rgba(0,0,0,.06)}
  .col.drag-over{border-color:var(--amber);background:rgba(245,166,35,.06)}
  .col.selected{border-color:rgba(245,166,35,.4);border-style:solid}

  /* ═══════════════════════════════════════════════════════
     BLOCKS (components inside cols)
  ═══════════════════════════════════════════════════════ */
  .block{
    position:relative;margin-bottom:6px;outline:2px solid transparent;
    border-radius:3px;transition:outline-color .12s;cursor:pointer;padding:0;margin:4px 0;
  }
  .block:hover{outline-color:rgba(245,166,35,.4)}
  .block.selected{outline-color:var(--amber)!important}
  .block-ctrl{
    position:absolute;top:-1px;right:-1px;z-index:10;
    display:flex;gap:2px;background:var(--amber);border-radius:0 3px 0 6px;
    padding:2px 4px;opacity:0;transition:opacity .12s;
  }
  .block:hover .block-ctrl,.block.selected .block-ctrl{opacity:1}
  .bc-btn{width:18px;height:18px;background:none;border:none;cursor:pointer;font-size:11px;color:#0d0d0e;display:grid;place-items:center;border-radius:3px}
  .bc-btn:hover{background:rgba(0,0,0,.15)}

  .block-handle{
    position:absolute;left:-20px;top:50%;transform:translateY(-50%);
    width:16px;height:24px;cursor:grab;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:2px;opacity:0;transition:opacity .12s;
  }
  .block:hover .block-handle{opacity:1}
  .block-handle span{width:10px;height:2px;background:var(--txt3);border-radius:2px;display:block}
  .block-handle:active{cursor:grabbing}

  /* ═══════════════════════════════════════════════════════
     BLOCK CONTENT STYLES
  ═══════════════════════════════════════════════════════ */
  .block [contenteditable]{
    outline:none;min-height:1em;word-break:break-word;
    caret-color:var(--amber);
  }

  .b-heading1[contenteditable]:empty::before,
  .b-heading2[contenteditable]:empty::before,
  .b-heading3[contenteditable]:empty::before {
    content: attr(data-placeholder);
    color: #bbb;
    pointer-events: none;
    font-style: italic;
  }

  .b-paragraph[contenteditable]:empty::before,
  .b-quote[contenteditable]:empty::before {
    content: none;
  }

  .b-heading1{font-family:Georgia,serif;font-size:2.2em;font-weight:700;line-height:1.2;color:#1a1a1a}
  .b-heading2{font-family:Georgia,serif;font-size:1.6em;font-weight:700;line-height:1.3;color:#1a1a1a}
  .b-heading3{font-family:Georgia,serif;font-size:1.25em;font-weight:700;line-height:1.4;color:#1a1a1a}
  .b-paragraph{font-size:1em;line-height:1.7;color:#333;font-family:Georgia,serif} 
  .b-list ul,.b-list ol{padding-left:1.4em;line-height:1.8;color:#333;font-family:Georgia,serif}
  .b-link a{color:#1a6cf0;text-decoration:underline;font-family:Georgia,serif}
  .b-divider hr{border:none;border-top:2px solid #e5e5e5;margin:4px 0}
  .b-button-wrap{display:flex}
  .b-btn{display:inline-block;padding:10px 24px;background:#1a1a1a;color:#fff;border-radius:6px;text-decoration:none;font-weight:600;font-size:.95em;cursor:default}
  .b-image-wrap img{max-width:100%;height:auto;display:block}
  .b-image-wrap{display:flex}
  .b-image-placeholder{background:#f0f0f0;border:2px dashed #ccc;border-radius:6px;min-height:120px;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:13px}
  .b-file{display: flex;width: 100%;}
  .b-file a {
    display: inline-block;
    text-decoration: underline;
    color: #1a6cf0;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .b-file a:hover {
    opacity: 0.8;
  }
  .b-file a[style*="border"] {
    padding: 8px 12px;
    border-radius: 4px;
  }
  .b-file[style*="justify-content: center"] a {
    margin: 0 auto;
  }
  .b-file[style*="justify-content: flex-end"] a {
    margin-left: auto;
  }
  .b-file[style*="justify-content: flex-start"] a {
    margin-right: auto;
  }
  .b-quote{border-left:4px solid #1a1a1a;padding:8px 16px;background:#f9f9f9;font-style:italic;color:#555;font-family:Georgia,serif;line-height:1.6}

  /* ═══════════════════════════════════════════════════════
     PREVIEW MODE
  ═══════════════════════════════════════════════════════ */
  body.preview-mode .palette,
  body.preview-mode .props-panel,
  body.preview-mode .format-bar,
  body.preview-mode .section-ctrl,
  body.preview-mode .block-ctrl,
  body.preview-mode .block-handle,
  body.preview-mode .add-section-btn{display:none!important}
  body.preview-mode .section{border-color:transparent!important}
  body.preview-mode .block{outline:none!important}
  body.preview-mode .col{border-color:transparent!important}
  body.preview-mode .col+.col{border-left:none}
  body.preview-mode [contenteditable]{pointer-events:none}
  body.preview-mode .canvas-wrap{padding:0}

  /* Toast */
  .toasts{position:fixed;bottom:18px;right:18px;display:flex;flex-direction:column;gap:8px;z-index:300}
  .toast{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:11px 15px;display:flex;align-items:center;gap:10px;font-size:12.5px;box-shadow:0 8px 28px rgba(0,0,0,.5);animation:tIn .25s ease;min-width:220px}
  .toast.ok{border-color:rgba(66,200,200,.3)}.toast.err{border-color:rgba(245,99,66,.3)}
  @keyframes tIn{from{transform:translateX(110%);opacity:0}to{transform:translateX(0);opacity:1}}
  @keyframes tOut{from{opacity:1}to{opacity:0;transform:translateX(110%)}}

  ::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--line);border-radius:10px}
  </style>
</head>
<body>
<%- include('../partials/spinner.ejs') %>

<div class="toolbar">
  <div class="tb-sep"></div>
  <span class="tb-file">
    Editando: <span><%= typeof dirPath !== 'undefined' && dirPath ? dirPath + '/' : '' %><%= typeof filename !== 'undefined' ? filename : 'nueva-pagina' %>.ejs</span>
  </span>
  <div class="tb-sep"></div>

  <div class="preview-toggle">
    <button class="active" id="btn-edit-mode" onclick="setMode('edit')">Editor</button>
    <button id="btn-preview-mode" onclick="setMode('preview')">Vista previa</button>
  </div>

  <div class="tb-spacer"></div>

  <a href="/dashboard" class="btn btn-ghost">← Volver</a>
  <button class="btn btn-amber" onclick="savePage()">💾 Guardar</button>
</div>

<div class="editor-shell">
<div class="toasts" id="toasts"></div>
  <!-- LEFT: Component Palette -->
  <div class="palette">
    <div class="palette-head">Componentes</div>
    <div class="palette-body">
      <div class="palette-sec">Texto</div>
      <div class="comp-item" draggable="true" data-type="heading1"><span class="comp-ico"><i class="bi bi-type-h1"></i></span> Título grande</div>
      <div class="comp-item" draggable="true" data-type="heading2"><span class="comp-ico"><i class="bi bi-type-h2"></i></span> Título medio</div>
      <div class="comp-item" draggable="true" data-type="heading3"><span class="comp-ico"><i class="bi bi-type-h3"></i></span> Título pequeño</div>
      <div class="comp-item" draggable="true" data-type="paragraph"><span class="comp-ico"><i class="bi bi-text-paragraph"></i></span> Párrafo</div>
      <div class="comp-item" draggable="true" data-type="quote"><span class="comp-ico"><i class="bi bi-quote"></i></span> Cita</div>

      <div class="palette-sec">Elementos</div>
      <div class="comp-item" draggable="true" data-type="list"><span class="comp-ico"><i class="bi bi-list-task"></i></span> Lista</div>
      <div class="comp-item" draggable="true" data-type="link"><span class="comp-ico"><i class="bi bi-link"></i></span> Enlace</div>
      <div class="comp-item" draggable="true" data-type="button"><span class="comp-ico"><i class="bi bi-app"></i></span> Botón</div>
      <div class="comp-item" draggable="true" data-type="divider"><span class="comp-ico"><i class="bi bi-hr"></i></span> Divisor</div>
      <div class="comp-item" draggable="true" data-type="image"><span class="comp-ico"><i class="bi bi-image"></i></span> Imagen</div>
      <div class="comp-item" draggable="true" data-type="file"><span class="comp-ico"><i class="bi bi-file-earmark"></i></span> Archivo</div>

      <div class="palette-sec">Estructura</div>
      <div class="comp-item" style="cursor:pointer" onclick="openModal(0,()=>{})" data-type="section">
        <span class="comp-ico"><i class="bi bi-layout-three-columns"></i></span> Nueva sección
      </div>
    </div>
  </div>

  <!-- CENTER: Canvas -->
  <div class="canvas-wrap" id="canvas-wrap">
    <div class="page-canvas" id="page-canvas">
    </div>
  </div>

  <!-- RIGHT: Properties Panel -->
  <div class="props-panel">
    <div class="pp-head">
      <span class="pp-title">Propiedades</span>
    </div>
    <div class="pp-body" id="pp-body">
      <div class="pp-empty">
        <div class="pp-empty-ico">◎</div>
        Selecciona un bloque o sección para editar sus propiedades
      </div>
    </div>
  </div>

</div>

<%- include('../components/modal',{idModal:"modalSecciones", titulo:"Nueva Sección",body:'../pages/modalColumnas.ejs'}) %>

<script >
  window.addEventListener('load', function() {
      const spinner = document.getElementById('spinner');
      if (spinner) spinner.classList.add('hidden');
  });

/* ── CONFIG ───────────────────────────────────────── */
const STORAGE_ID  = '<%= typeof storageId !== "undefined" ? storageId : 1 %>';
const DIR_PATH    = '<%= typeof dirPath !== "undefined" ? dirPath : "" %>'.replace(/\\/g, '/');
const FILENAME    = '<%= typeof filename !== "undefined" ? filename : "pagina" %>';
const INITIAL_EJS = <%- typeof ejsContent !== 'undefined' ? JSON.stringify(ejsContent) : '""' %>;
const url_api = '<%= typeof url_api !== "undefined" ? url_api : "" %>';

/* ── STATE ────────────────────────────────────────── */
let selectedBlock   = null;
let selectedSection = null;
let dragSrcBlock    = null;
let dragSrcCol      = null;
let sectionLayoutSel = { cols: 1, flex: null, bg: '#ffffff' };
let history = [];
let historyIdx = -1;
let undoing = false;

/* ── COUNTERS ─────────────────────────────────────── */
let secCounter  = 0;
let blockCounter = 0;

/* ── INIT ─────────────────────────────────────────── */
window.addEventListener('DOMContentLoaded', () => {
  if (INITIAL_EJS.trim()) {
    loadFromHTML(INITIAL_EJS);
  } else {
    addSectionToCanvas(1, null, '#ffffff');
  }
  pushHistory();
});

/* ═══════════════════════════════════════════════════
   SECTION MODAL
═══════════════════════════════════════════════════ */
function openSectionModal() {
  sectionLayoutSel = { cols: 1, flex: null, bg: '#ffffff' };
  document.querySelectorAll('.layout-opt').forEach(o => o.classList.remove('sel'));
  const firstOpt = document.querySelector('[data-cols="1"]');
  if (firstOpt) firstOpt.classList.add('sel');
  $('#modalSecciones').modal('show');
}

const closeModalBtn = document.getElementById('closeModalBtn');
if (closeModalBtn) {
  closeModalBtn.addEventListener('click',()=>{
    closeModal();
  });
}
function closeSectionModal(e) {
  if (e && e.target.id !== 'section-overlay') return;
   $('#modalSecciones').modal('hide');
}
function selectLayout(el) {
  document.querySelectorAll('.layout-opt').forEach(o => o.classList.remove('sel'));
  el.classList.add('sel');
  sectionLayoutSel.cols = parseInt(el.dataset.cols);
  sectionLayoutSel.flex = el.dataset.flex || null;
}
function selectSwatch(el) {
  document.querySelectorAll('.swatch').forEach(s => s.classList.remove('sel'));
  el.classList.add('sel');
  sectionLayoutSel.bg = el.dataset.color;
}
function addSection() {
  addSectionToCanvas(sectionLayoutSel.cols, sectionLayoutSel.flex, sectionLayoutSel.bg);
  closeModal();
  pushHistory();
}

/* ═══════════════════════════════════════════════════
   BUILD SECTION DOM
═══════════════════════════════════════════════════ */
function addSectionToCanvas(cols, flex, bg, insertBefore = null) {
  const secId = 'sec-' + (++secCounter);
  const sec   = document.createElement('div');
  sec.className = 'section';
  sec.dataset.secid = secId;
  sec.dataset.bg = bg || '#ffffff';
  sec.style.backgroundColor = bg || '#ffffff';
  sec.style.padding = '0';

  sec.innerHTML = `
    <div class="section-ctrl">
      <button class="sc-btn" onclick="moveSectionUp(this)" title="Subir">↑</button>
      <button class="sc-btn" onclick="moveSectionDown(this)" title="Bajar">↓</button>
      <button class="sc-btn" onclick="openSectionProps(this)" title="Propiedades">⚙</button>
      <button class="sc-btn red" onclick="deleteSection(this)" title="Eliminar">✕</button>
    </div>
    <div class="section-cols" data-secid="${secId}"></div>`;

  const colsWrap = sec.querySelector('.section-cols');
  const flexArr = flex ? flex.split(',').map(Number) : Array(cols).fill(1);
  for (let i = 0; i < cols; i++) {
    const col = buildCol(secId, i, flexArr[i] || 1);
    colsWrap.appendChild(col);
  }

  sec.addEventListener('click', e => {
    if (!e.target.closest('.block') && !e.target.closest('.sc-btn')) {
      selectSection(sec);
    }
  });

  const canvas = document.getElementById('page-canvas');
  if (insertBefore) {
    canvas.insertBefore(sec, insertBefore);
  } else {
    canvas.appendChild(sec);
  }
  return sec;
}

function buildCol(secId, idx, flexVal) {
  const col = document.createElement('div');
  col.className = 'col';
  col.dataset.secid = secId;
  col.dataset.colidx = idx;
  col.style.flex = flexVal;

  col.addEventListener('dragover', e => {
    e.preventDefault();
    col.classList.add('drag-over');
  });
  col.addEventListener('dragleave', () => col.classList.remove('drag-over'));
  col.addEventListener('drop', e => {
    e.preventDefault();
    col.classList.remove('drag-over');
    const type = e.dataTransfer.getData('block-type');
    const srcId = e.dataTransfer.getData('block-id');

    if (type) {
      const block = createBlock(type);
      col.appendChild(block);
      selectBlock(block);
      pushHistory();
    } else if (srcId) {
      const existing = document.getElementById(srcId);
      if (existing) {
        col.appendChild(existing);
        selectBlock(existing);
        pushHistory();
      }
    }
  });
  return col;
}

/* ═══════════════════════════════════════════════════
   CREATE BLOCK
═══════════════════════════════════════════════════ */
function createBlock(type, data = {}) {
  const id = 'blk-' + (++blockCounter);
  const wrap = document.createElement('div');
  wrap.className = 'block';
  wrap.id = id;
  wrap.dataset.type = type;
  wrap.draggable = true;

  if (type === 'image') {
    setTimeout(() => {
      const placeholder = wrap.querySelector('.b-image-placeholder');
      if (placeholder) {
        placeholder.addEventListener('click', (e) => {
          e.stopPropagation();
          selectBlock(wrap);
          const url = prompt('Ingresa la URL de la imagen:', 'https://');
          if (url) {
            setImageSrc(url);
          }
        });
      }
    }, 0);
  }

  let defaultStyles = "";
  if (type === 'heading1') defaultStyles = 'font-size: 35px;';
  else if (type === 'heading2') defaultStyles = 'font-size: 30px;';
  else if (type === 'heading3') defaultStyles = 'font-size: 25px;';
  else if (type === 'paragraph') defaultStyles = 'font-size: 16px;';
  else if (type === 'quote') defaultStyles = 'font-size: 14px;';
  else if (type === 'list') defaultStyles = 'font-size: 16px;';

  const finalStyles = data.style ? data.style : defaultStyles;

  wrap.innerHTML = `
    <div class="block-handle"><span></span><span></span><span></span></div>
    <div class="block-ctrl">
      <button class="bc-btn" onclick="moveBlockUp(this)" title="Subir">↑</button>
      <button class="bc-btn" onclick="moveBlockDown(this)" title="Bajar">↓</button>
      <button class="bc-btn" onclick="duplicateBlock(this)" title="Duplicar">⧉</button>
      <button class="bc-btn" onclick="deleteBlock(this)" title="Eliminar">✕</button>
    </div>
    ${blockInnerHTML(type, {...data, style:finalStyles})}`;

  wrap.addEventListener('dragstart', e => {
    e.dataTransfer.setData('block-id', id);
    e.stopPropagation();
    setTimeout(() => wrap.style.opacity = '.4', 0);
  });
  wrap.addEventListener('dragend', () => { wrap.style.opacity = '1'; });

  wrap.addEventListener('click', e => {
    if (e.target.tagName === 'A' || e.target.closest('a')) {
      return;
    }
    e.stopPropagation();
    selectBlock(wrap);
  });

  let debTimer;
  wrap.addEventListener('input', () => {
    clearTimeout(debTimer);
    debTimer = setTimeout(pushHistory, 800);
  });

  return wrap;
}

function blockInnerHTML(type, data = {}) {
  const style = data.style || '';
  switch(type) {
    case 'heading1':  return `<div class="b-heading1"  contenteditable="true" data-placeholder="Título principal" style="${style}">${data.text !== undefined ? data.text :''}</div>`;
    case 'heading2':  return `<div class="b-heading2"  contenteditable="true" data-placeholder="Subtítulo" style="${style}">${data.text !== undefined ? data.text :''}</div>`;
    case 'heading3':  return `<div class="b-heading3"  contenteditable="true" data-placeholder="Encabezado menor" style="${style}">${data.text !== undefined ? data.text :''}</div>`;
    case 'paragraph': return `<div class="b-paragraph" contenteditable="true" data-placeholder="Escribe un párrafo..." style="${style}">${data.text !== undefined ? data.text :''}</div>`;
    case 'quote':     return `<blockquote class="b-quote" contenteditable="true" data-placeholder="Escribe una cita..." style="${style}">${data.text !== undefined ? data.text :''}</blockquote>`;
    case 'list': {
      const listType = data.listType === 'ol' ? 'ol' : 'ul';
      const styleType = data.listStyleType || (listType === 'ol' ? 'decimal' : 'disc');
      return `<div class="b-list" style="${style}"><${listType} contenteditable="true" style="list-style-type:${styleType};list-style-position:outside;padding-left:1.4em;">${data.listHTML || '<li>' + (data.text || 'Elemento de lista') + '</li>'}</${listType}></div>`;
    }
    case 'link':
      return `<div class="b-link" style="${style}"><a href="${data.href||'#'}" contenteditable="true" data-placeholder="Texto del enlace">${data.text !== undefined ? data.text :'Mi Enlace'}</a></div>`;
    case 'button':
      return `<div class="b-button-wrap" style="justify-content:${data.align||'flex-start'}"><a href="${data.href||'#'}" class="b-btn" style="${style}" contenteditable="true">${data.text || 'Botón'}</a></div>`;
    case 'divider':
      return `<div class="b-divider"><hr/></div>`;
    case 'image':
      const align = data.align || 'flex-start';
      const imgStyle = data.style || '';
      if (data.src) {
        return `<div class="b-image-wrap" style="justify-content:${align}">
                  <img src="${data.src}" alt="${data.alt || ''}" style="max-width:100%;height:auto;display:block;${imgStyle}"/>
                </div>`;
      } else {
        return `<div class="b-image-placeholder" style="display:flex;align-items:center;justify-content:center;min-height:120px;background:#f0f0f0;border:2px dashed #ccc;border-radius:6px;color:#aaa;font-size:13px;cursor:pointer;" onclick="this.closest('.block') && selectBlock(this.closest('.block'))">
                  🖼 Haz clic para agregar imagen
                </div>`;
      }
    case 'file':
      const fileStyle = data.style || '';
      const fileAlign = data.align || 'flex-start';
      return `<div class="b-file" style="display:flex;justify-content:${fileAlign};${fileStyle}">
            <a href="${data.href || '#'}" 
               ${data.download ? 'download' : ''} 
               ${data.target ? `target="${data.target}"` : ''}
               style="${data.linkStyle || ''}">
              ${data.text || 'Descargar archivo'}
            </a>
          </div>`;
    default: return "";
  }
}

/* ═══════════════════════════════════════════════════
   PALETTE DRAG
═══════════════════════════════════════════════════ */
document.querySelectorAll('.comp-item[draggable]').forEach(item => {
  item.addEventListener('dragstart', e => {
    e.dataTransfer.setData('block-type', item.dataset.type);
  });
});

/* ═══════════════════════════════════════════════════
   SELECTION
═══════════════════════════════════════════════════ */
function selectBlock(block) {
  document.querySelectorAll('.block.selected').forEach(b => b.classList.remove('selected'));
  document.querySelectorAll('.section.selected').forEach(s => s.classList.remove('selected'));
  selectedBlock   = block;
  selectedSection = null;
  block.classList.add('selected');
  renderBlockProps(block);
}

function selectSection(sec) {
  document.querySelectorAll('.block.selected').forEach(b => b.classList.remove('selected'));
  document.querySelectorAll('.section.selected').forEach(s => s.classList.remove('selected'));
  selectedSection = sec;
  selectedBlock   = null;
  sec.classList.add('selected');
  renderSectionProps(sec);
}

document.getElementById('canvas-wrap').addEventListener('click', e => {
  if (!e.target.closest('.block') && !e.target.closest('.section')) {
    document.querySelectorAll('.block.selected, .section.selected').forEach(el => el.classList.remove('selected'));
    selectedBlock = null; selectedSection = null;
    document.getElementById('pp-body').innerHTML = `<div class="pp-empty"><div class="pp-empty-ico">◎</div>Selecciona un bloque o sección</div>`;
  }
});

function setBlockStyle(prop, val) {
  setPropStyle(prop, val);
}

/* ═══════════════════════════════════════════════════
   PROPERTIES PANEL
═══════════════════════════════════════════════════ */
function renderBlockProps(block) {
  const type = block.dataset.type;
  
  const isImage = (type === 'image');
  const isFile = (type === 'file');
  const isLink = (type === 'link');
  const isButton = (type === 'button');
  const isDivider = (type === 'divider');
  const isList = (type === 'list');
  const isText = ['heading1', 'heading2', 'heading3', 'paragraph', 'quote'].includes(type);
  
  let html = `<p class="pp-sec">Bloque: ${typeLabel(type)}</p>`;

  if (isText) {
    const content = getEditableElement(block); 
    if (!content) {
      html += `<div class="pp-empty">Bloque de texto sin editor</div>`;
    } else {
      const computedStyle = window.getComputedStyle(content);
      const inlineStyle = content.style;

      function getStyleValue(property, defaultValue = '') {
        if (inlineStyle[property]) return inlineStyle[property];
