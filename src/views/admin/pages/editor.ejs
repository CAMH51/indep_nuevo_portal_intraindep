          <input type="number" class="pp-input" style="width:70px" value="${fontSizeNum}"
            oninput="setPropStyle('fontSize', this.value ? this.value + 'px' : '')"
            onchange="setPropStyle('fontSize', this.value ? this.value + 'px' : '')"/></div>
        <div class="pp-row"><span class="pp-label">Familia</span>
          <select class="pp-select" onchange="setPropStyle('fontFamily', this.value)">
            <option value="">Por defecto</option>
            <option value="'Outfit', sans-serif" ${fontFamily.includes('Outfit') ? 'selected' : ''}>Outfit</option>
            <option value="'DM Serif Display', serif" ${fontFamily.includes('DM Serif Display') ? 'selected' : ''}>DM Serif Display</option>
            <option value="'JetBrains Mono', monospace" ${fontFamily.includes('JetBrains Mono') ? 'selected' : ''}>JetBrains Mono</option>
            <option value="'Noto Sans Regular', sans-serif" ${fontFamily.includes('Noto Sans') ? 'selected' : ''}>Noto Sans</option>
            <option value="Georgia, serif" ${fontFamily.includes('Georgia') ? 'selected' : ''}>Georgia</option>
            <option value="Arial, sans-serif" ${fontFamily.includes('Arial') ? 'selected' : ''}>Arial</option>
            <option value="'Courier New', monospace" ${fontFamily.includes('Courier') ? 'selected' : ''}>Courier New</option>
            <option value="'Times New Roman', serif" ${fontFamily.includes('Times') ? 'selected' : ''}>Times New Roman</option>
            <option value="Verdana, sans-serif" ${fontFamily.includes('Verdana') ? 'selected' : ''}>Verdana</option>
          </select></div>
        <div class="pp-row"><span class="pp-label">Estilo</span>
          <div class="pp-btns">
            <button class="pp-btn ${isStyleActive('fontWeight', 'bold') ? 'on' : ''}" 
              onclick="togglePropStyle('fontWeight', 'bold', 'normal')"><b>B</b></button>
            <button class="pp-btn ${isStyleActive('fontStyle', 'italic') ? 'on' : ''}" 
              onclick="togglePropStyle('fontStyle', 'italic', 'normal')"><i>I</i></button>
            <button class="pp-btn ${isStyleActive('textDecoration', 'underline') ? 'on' : ''}" 
