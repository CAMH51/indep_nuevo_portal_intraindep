<div class="shadow-lg p-4 bg-white p-4 rounded-xl bg-white">
    <p class="p-2 text-2xl font-bold"><i class="bi bi-list-task"></i> Listado de Ligas</p>
    <div class="basis-2/3 mb:basis-2/3">
        <%- include('../../components/table',{idTable:'tablaLiga'}) %>
        <%- include('../../components/scriptDataTable') %>
    </div>
</div>

<%- include('../../components/modal',{idModal:"modalLiga", titulo:"Editar Liga",body:'../pages/ligas/form_editar.ejs'}) %>

<script >

    //columnas de la tabla 
    const columnasTableLiga=[
        {title:'Id',data:'id_liga',width:'50px',className:'text-center'},
        {title:'Nombre de la liga',data:'nombre_liga',width:'250px'},
        {title:'Página Asociada',data:'pagina.nombre_pag',width:'200px'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                let html = "";
                html += `<a onclick="openModal(${row.id_liga},obtenerLiga)" class="text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>`;
                if(row.activo){
                    html +=`
                        <a onclick="activarLiga(${row.id_liga},'false')" class="text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    html += `
                        <a onclick="activarLiga(${row.id_liga},'true')" class="text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
                return html;
            }
        },

    ];


    /*
        función verTabla que se encuentra en la vista del componente table 
        verTabla(Columnas,id de la tabla,ruta de los datos);
    */

    verTabla(columnasTableLiga,{},'#tablaLiga','/ligas/user/<%=id_user%>');

    /*
        Función para obtener los datos de la liaga a editar, pasando el id de dicha liga.
        En las columnas se pasa un link con un onclick y la funcion openModal con los parametros del id de la liga y la funcion obtenerLiga que es un callback
    */

    async function  obtenerLiga(id){
        const response = await fetch(`/ligas/${id}`);
        const data = await response.json();
        if(data.success){
            document.getElementById('id_liga').value = data.data.id_liga;
            document.getElementById('editNombreLiga').value = data.data.nombre_liga;
            document.getElementById('editUrlLiga').value = data.data.url_liga;
            document.getElementById('editPagina').value = data.data.fk_id_pagina || "";
            document.getElementById('editUrlExterna').value = data.data.url_liga;
        }
    }

    /*
        función que llama a la ruta activar y manda el estatus para activar o desactivar la noticia.
    */
    async function activarLiga(id,status){
        const formData = new FormData();
        formData.append('status',status);
        const response = await fetch(`/ligas/activar/${id}`,{
            method: 'PUT',
            body:formData
        });
        const data = await response.json();
        console.log(data);

        //Esta funcion viene de la vista table y refresca eb tiempo real la tabla
        refrescarTabla('#tablaLiga')
    }

    closeModalBtn.addEventListener('click',()=>{
            // Limpiar todos los mensajes de error
        document.querySelectorAll('.msg').forEach(el => {
            el.className = 'msg';
            el.innerHTML = '';
        });

        // Remover clases de error/éxito de todos los campos
        document.querySelectorAll('.field').forEach(el => {
            el.classList.remove('border-red-500', 'border-green-500', 'is-invalid', 'is-valid');
        });
        closeModal();
    });
</script>