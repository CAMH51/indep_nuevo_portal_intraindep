<!-- views/partials/session-warning.ejs -->
<% if (locals.sessionWarning) { %>

  <div id="session-banner"  class="fixed z-10 right-10 bottom-10 shadow-lg rounded-xl bg-white p-4">
    <div class="text-center mb-7">
      <p class="text-xl text-rojo-claro font-bold">Tu sesión expira en: </p>
    </div>
    <div class="text-center mb-7">
      <strong class="border border-4 border-rojo-claro rounded-[50%] p-5"  ><span id="countdown"><%= sessionExpiresIn %></span>s</strong>
    </div>
    <div>
      <button class="bg-verde-claro text-white font-bold  rounded-md p-2" onclick="renewSession()">Renovar sesión</button>

      <button class="bg-gris text-white font-bold rounded-md p-2" onclick="document.getElementById('session-banner').remove()">Ignorar</button>
      
    </div>
  </div>
