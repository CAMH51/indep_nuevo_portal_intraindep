<script >
  let secs = <%= sessionExpiresIn %>;
  const cd = document.getElementById('countdown');
  const tick = setInterval(() => {
    secs--;
    if (cd) cd.textContent = secs;
    if (secs <= 0) {
      clearInterval(tick);
      // Sesión expiró mientras el usuario estaba en la página
      alert('Tu sesión ha expirado. Serás redirigido al login.');
      window.location.href = '/?expired=1';
    }
  }, 1000);

  async function renewSession() {
    try {
      const res = await fetch('/auth/refresh', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const data = await res.json();
      if (data.success) {
        document.getElementById('session-banner').remove();
        clearInterval(tick);
        // Opcional: mostrar toast de éxito
      } else {
        //window.location.href = '/';
      }
    } catch {
      //window.location.href = '/';
    }
  }
</script>
<% } %>