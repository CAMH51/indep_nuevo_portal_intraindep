
<body class="bg-gray-50 antialiased">

    <!-- Estructura principal: flex para sidebar y main -->
    <div class="flex h-screen overflow-hidden">
        
        <!-- ======================= SIDEBAR (ocultable sin iconos, con menús desplegables) ======================= -->
       <%- include('partials/sidebar') %>

        <!-- ======================= CONTENIDO PRINCIPAL ======================= -->
        <div class="flex-1 flex flex-col overflow-hidden main-content-transition">
            
            <!-- BARRA DE NAVEGACIÓN (navbar) con botón toggle sidebar + título + avatar -->
          <%- include('partials/header') %>

            <!-- MAIN: cards y tabla + botón agregar páginas (scrolleable) -->
            <main class="flex-1 overflow-y-auto p-4 md:p-6 bg-gray-50">
                <div class="max-w-9/10 mx-auto">
                    <%- include('partials/session-warning') %>
                    <%- include('pages/' + page ) %>
                    <!-- Sección de tarjetas (cards) -->
                    
                </div>
            </main>

            <!-- FOOTER -->
             <%- include('partials/footer') %>
            
        </div>
    </div>

    <script >

        (function() {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleSidebarBtn');
            const toggleBtnText = document.getElementById('toggleBtnText');
            let sidebarVisible = true;
            const SIDEBAR_WIDTH = 280; // en px
            
            // Función para ocultar/mostrar sidebar sin animación abrupta, con transición
            function setSidebarVisibility(visible) {
                if (visible) {
                    sidebar.style.width = SIDEBAR_WIDTH + 'px';
                    sidebar.style.opacity = '1';
                    sidebar.style.visibility = 'visible';
                    sidebar.style.position = 'relative';
                    sidebar.classList.remove('w-0', 'overflow-hidden');
                    toggleBtnText.innerText = 'Ocultar';
                    sidebarVisible = true;
                } else {
                    sidebar.style.width = '0px';
                    sidebar.style.opacity = '0';
                    sidebar.style.visibility = 'hidden';
                    sidebar.style.position = 'relative';
                    sidebar.classList.add('overflow-hidden');
                    toggleBtnText.innerText = 'Mostrar';
                    sidebarVisible = false;
                }
                // Pequeño ajuste para evitar desborde del contenido interno cuando está oculto
                if(!visible) {
                    // opcional
                } else {
                    sidebar.style.visibility = 'visible';
                }
            }
            
            // Estado inicial visible
            setSidebarVisibility(true);
            
            // Evento toggle
            toggleBtn.addEventListener('click', () => {
                setSidebarVisibility(!sidebarVisible);
            });
            
            // Responsive opcional: si la pantalla es muy pequeña (menos de 768px) podríamos iniciar oculto? pero no necesario
            // Pero por si acaso, se adapta bien.
            // Gestión de botón "Agregar página" (tabla dinámica)
            const tableBody = document.getElementById('tableBody');
            const addPageBtn = document.getElementById('addPageBtn');
            
            // Contador auxiliar para IDs únicos y títulos
            let pageCounter = 4; // siguiente ID después de 3 ejemplos
            
            function createNewPageRow(title, status = 'Borrador', visits = '0', lastMod = new Date().toLocaleDateString('es-ES')) {
                const newId = `P-10${pageCounter}`;
                pageCounter++;
                const randomVisits = Math.floor(Math.random() * 5000) + 100;
                const visitsFormatted = randomVisits.toLocaleString();
                const statusClass = status === 'Publicado' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800';
                const statusText = status;
                const currentDate = new Date().toLocaleDateString('es-ES');
                
                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 transition';
                row.innerHTML = `
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${newId}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">${escapeHtml(title)}</td>
                    <td class="px-6 py-4 whitespace-nowrap"><span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${statusClass}">${statusText}</span></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">${visitsFormatted}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${lastMod || currentDate}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <a href="#" class="text-indigo-600 hover:text-indigo-900 mr-3"><i class="far fa-edit"></i></a>
                        <a href="#" class="text-red-500 hover:text-red-700 delete-row"><i class="far fa-trash-alt"></i></a>
                    </td>
                `;
                // Evento eliminar para la nueva fila
                const deleteBtn = row.querySelector('.delete-row');
                if (deleteBtn) {
                    deleteBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        row.remove();
                        updateFooterCounter();
                    });
                }
                return row;
            }
            
            // Helper para escapar HTML básico
            function escapeHtml(str) {
                return str.replace(/[&<>]/g, function(m) {
                    if (m === '&') return '&amp;';
                    if (m === '<') return '&lt;';
                    if (m === '>') return '&gt;';
                    return m;
                }).replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, function(c) {
                    return c;
                });
            }
            
            // Función para actualizar el contador del footer (número de páginas)
            function updateFooterCounter() {
                const rows = tableBody.querySelectorAll('tr');
                const footerSpan = document.querySelector('.bg-gray-50 .text-gray-500 span');
                if (footerSpan) {
                    footerSpan.innerText = `Mostrando ${rows.length} de ${rows.length} páginas`;
                }
                // deshabilitar botones si no hay registros, pero mantenemos simple
                const prevBtn = document.querySelector('.bg-gray-50 .flex.gap-2 button:first-child');
                const nextBtn = document.querySelector('.bg-gray-50 .flex.gap-2 button:last-child');
                if (prevBtn && rows.length === 0) {
                    prevBtn.disabled = true;
                    if (nextBtn) nextBtn.disabled = true;
                } else if (prevBtn) {
                    prevBtn.disabled = false;
                    if (nextBtn) nextBtn.disabled = false;
                }
            }
            
            // Agregar página: muestra prompt para nombre y permite seleccionar estado opcional
            addPageBtn.addEventListener('click', () => {
                // Modal básico con prompt nativo mejorado o un mini diálogo custom? usaremos window.prompt simple pero elegante
                const pageTitle = prompt('Ingresa el título de la nueva página:', 'Nueva página');
                if (pageTitle === null || pageTitle.trim() === '') {
                    // si cancela o vacío no hace nada
                    return;
                }
                // Preguntar estado con confirm? mejor un select simple pero usamos confirm para simplicidad: si acepta publicado sino borrador
                const isPublished = confirm('¿Publicar la página ahora? (Aceptar = Publicado / Cancelar = Borrador)');
                const status = isPublished ? 'Publicado' : 'Borrador';
                const today = new Date().toLocaleDateString('es-ES');
                const newRow = createNewPageRow(pageTitle.trim(), status, '0', today);
                tableBody.appendChild(newRow);
                updateFooterCounter();
                // opcional: efecto scroll suave al final
                newRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
            
            // Agregar evento eliminar a las filas existentes (las del html inicial)
            document.querySelectorAll('#tableBody .delete-row').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const row = btn.closest('tr');
                    if (row) row.remove();
                    updateFooterCounter();
                });
            });
            
            // Inicializar contador footer
            updateFooterCounter();
            
            // Pequeño ajuste: asegurar que en dispositivos móviles la experiencia de ocultar sidebar sea buena
            // añadir listener de resize si es necesario (no crítico)
        })();
    </script>
</body>